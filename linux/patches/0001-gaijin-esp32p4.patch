--- a/Documentation/devicetree/bindings/reserved-memory/linux,nommu-userspace-pool.yaml
+++ b/Documentation/devicetree/bindings/reserved-memory/linux,nommu-userspace-pool.yaml
@@ -0,0 +1,57 @@
+# SPDX-License-Identifier: GPL-2.0
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/reserved-memory/linux,nommu-userspace-pool.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Reserved pool for large NOMMU user-space mmap allocations
+
+description: |
+  On systems built without an MMU (CONFIG_MMU=n), every userspace mmap
+  for a private mapping is satisfied by a single physically contiguous
+  page range obtained from the buddy allocator. After a few minutes of
+  normal activity the buddy heap on a small NOMMU box (tens of MB)
+  routinely fragments below the order needed to fork a non-trivial
+  binfmt_flat binary or to malloc more than a few hundred kilobytes,
+  even though several megabytes of memory remain free.
+
+  CONFIG_CMA — the standard answer on MMU systems — depends on MMU
+  and is not available. This binding describes a reserved memory
+  region which the kernel's NOMMU mmap path will draw large user
+  allocations from before falling back to the buddy allocator.
+
+  The region is served by a gen_pool created at early boot. Pool
+  allocations are page-aligned but not power-of-two-rounded, so the
+  pool is denser than buddy for binfmt_flat allocations and can hand
+  out single allocations larger than MAX_PAGE_ORDER.
+
+maintainers:
+  - Rory Breuk <rory.breuk@gmail.com>
+
+allOf:
+  - $ref: reserved-memory.yaml
+
+properties:
+  compatible:
+    const: linux,nommu-userspace-pool
+
+  reg: true
+
+unevaluatedProperties: false
+
+required:
+  - compatible
+  - reg
+
+examples:
+  - |
+    reserved-memory {
+        #address-cells = <1>;
+        #size-cells = <1>;
+
+        app_pool: app-pool@49200000 {
+            compatible = "linux,nommu-userspace-pool";
+            reg = <0x49200000 0x00a00000>;
+        };
+    };
+...
