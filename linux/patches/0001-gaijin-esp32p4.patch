@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Register bit order from the MIT Tanmatsu coprocessor interface,
+ * SPDX-FileCopyrightText: 2024 Nicolai Electronics
+ * Linux translation and space-bar aggregation are original Gaijin code.
+ */
+#ifndef _TANMATSU_KEYS_H
+#define _TANMATSU_KEYS_H
+#include <linux/input-event-codes.h>
+
+#define TANMATSU_KEY_BYTES 9
+static const unsigned short tanmatsu_keycodes[72] = {
+	KEY_ESC, KEY_F1, KEY_F2, KEY_F3, KEY_GRAVE, KEY_1, KEY_2, KEY_3,
+	KEY_TAB, KEY_Q, KEY_W, KEY_E, KEY_FN, KEY_A, KEY_S, KEY_D,
+	KEY_LEFTSHIFT, KEY_Z, KEY_X, KEY_C, KEY_LEFTCTRL, KEY_LEFTMETA,
+	KEY_LEFTALT, KEY_BACKSLASH,
+	KEY_4, KEY_5, KEY_6, KEY_7, KEY_R, KEY_T, KEY_Y, KEY_U,
+	KEY_F, KEY_G, KEY_H, KEY_J, KEY_V, KEY_B, KEY_N, KEY_M,
+	KEY_F4, KEY_F5, KEY_F6, KEY_BACKSPACE, KEY_9, KEY_0, KEY_MINUS, KEY_EQUAL,
+	KEY_O, KEY_P, KEY_LEFTBRACE, KEY_RIGHTBRACE, KEY_L, KEY_SEMICOLON,
+	KEY_APOSTROPHE, KEY_ENTER,
+	KEY_DOT, KEY_SLASH, KEY_UP, KEY_RIGHTSHIFT, KEY_RIGHTALT,
+	KEY_LEFT, KEY_DOWN, KEY_RIGHT,
+	KEY_8, KEY_I, KEY_K, KEY_COMMA, KEY_SPACE, KEY_RESERVED, KEY_RESERVED,
+	KEY_VOLUMEUP,
+};
+
+static inline int tanmatsu_key_down(const unsigned char *keys, unsigned int scan)
+{
+	/* Three switches form one logical space key; releasing one must not
+	 * release space while another switch is still pressed.
+	 */
+	if (scan == 68)
+		return !!(keys[8] & 0x70);
+	return !!(keys[scan / 8] & (1U << (scan % 8)));
+}
+#endif
--- a/drivers/input/keyboard/tanmatsu-mcu.c
+++ b/drivers/input/keyboard/tanmatsu-mcu.c
@@ -0,0 +1,294 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Tanmatsu rev7 management MCU r9, input/backlight protocol owner.
+ * Register protocol derived from the MIT Tanmatsu coprocessor interface:
+ * SPDX-FileCopyrightText: 2024 Nicolai Electronics
+ * Linux integration is original Gaijin code. No ESP-IDF runtime calls.
+ */
+#include <linux/backlight.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/module.h>
+#include <linux/delay.h>
+#include <linux/reboot.h>
+#include "tanmatsu-keys.h"
+
+#define TANMATSU_FW 9
+struct tanmatsu_mcu {
+	struct i2c_client *client;
+	struct gpio_desc *volume_down;
+	struct backlight_device *backlight;
+	struct notifier_block reboot_notifier;
+	unsigned int read_errors;
+	bool failed;
+};
+
+static int tanmatsu_read(struct i2c_client *client, u8 reg, u8 *data, u16 count)
+{
+	struct i2c_msg msgs[] = {
+		{ .addr = client->addr, .len = 1, .buf = &reg },
+		{ .addr = client->addr, .flags = I2C_M_RD, .len = count, .buf = data },
+	};
+	int ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+
+	return ret == ARRAY_SIZE(msgs) ? 0 : (ret < 0 ? ret : -EIO);
+}
+
+static void tanmatsu_release(struct input_dev *input)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(tanmatsu_keycodes); i++)
+		if (tanmatsu_keycodes[i] != KEY_RESERVED)
+			input_report_key(input, tanmatsu_keycodes[i], 0);
+	input_report_key(input, KEY_POWER, 0);
+	input_report_key(input, KEY_VOLUMEDOWN, 0);
+	input_report_switch(input, SW_HEADPHONE_INSERT, 0);
+	input_sync(input);
+}
+
+static void tanmatsu_poll(struct input_dev *input)
+{
+	struct tanmatsu_mcu *mcu = input_get_drvdata(input);
+	u8 snapshot[2 + TANMATSU_KEY_BYTES], inputs;
+	unsigned int i;
+	int ret, volume = 0;
+
+	/* Read identity on every sample, including after an MCU restart.
+	 * Never interpret a partial transfer or unsupported firmware as keys.
+	 * Reading interrupt-reason register 13 is unnecessary in polling mode.
+	 */
+	ret = tanmatsu_read(mcu->client, 0, snapshot, sizeof(snapshot));
+	if (!ret && (snapshot[0] != TANMATSU_FW || snapshot[1] != 0))
+		ret = -EPROTONOSUPPORT;
+	if (!ret)
+		ret = tanmatsu_read(mcu->client, 15, &inputs, 1);
+	if (!ret && mcu->volume_down) {
+		volume = gpiod_get_value_cansleep(mcu->volume_down);
+		if (volume < 0)
+			ret = volume;
+	}
+	if (ret) {
+		mcu->read_errors++;
+		if (!mcu->failed)
+			dev_warn(&mcu->client->dev, "input read failed (%d); releasing keys\n", ret);
+		mcu->failed = true;
+		tanmatsu_release(input);
+		return;
+	}
+	if (mcu->failed)
+		dev_info(&mcu->client->dev, "input recovered (MCU r9)\n");
+	mcu->failed = false;
+	for (i = 0; i < ARRAY_SIZE(tanmatsu_keycodes); i++)
+		if (tanmatsu_keycodes[i] != KEY_RESERVED)
+			input_report_key(input, tanmatsu_keycodes[i],
+					 tanmatsu_key_down(snapshot + 2, i));
+	input_report_key(input, KEY_VOLUMEDOWN, volume);
+	input_report_key(input, KEY_POWER, !!(inputs & BIT(2)));
+	input_report_switch(input, SW_HEADPHONE_INSERT, !!(inputs & BIT(1)));
+	input_sync(input);
+}
+
+/* Adapter locking serializes backlight commands and input snapshots. Every
+ * write is gated on r9, including after a management MCU restart.
+ */
+static int tanmatsu_backlight_update(struct backlight_device *bl)
+{
+	struct i2c_client *client = bl_get_data(bl);
+	u8 version[2], command[] = { 11, backlight_get_brightness(bl) };
+	int ret;
+
+	ret = tanmatsu_read(client, 0, version, sizeof(version));
+	if (ret)
+		return ret;
+	if (version[0] != TANMATSU_FW || version[1])
+		return -EPROTONOSUPPORT;
+	ret = i2c_master_send(client, command, sizeof(command));
+	return ret == sizeof(command) ? 0 : (ret < 0 ? ret : -EIO);
+}
+
+static int tanmatsu_backlight_get(struct backlight_device *bl)
+{
+	u8 value;
+	int ret = tanmatsu_read(bl_get_data(bl), 11, &value, 1);
+
+	return ret ? ret : value;
+}
+
+static const struct backlight_ops tanmatsu_backlight_ops = {
+	.update_status = tanmatsu_backlight_update,
+	.get_brightness = tanmatsu_backlight_get,
+};
+
+static int tanmatsu_blank_on_shutdown(struct notifier_block *notifier,
+				      unsigned long action, void *data)
+{
+	struct tanmatsu_mcu *mcu = container_of(notifier, struct tanmatsu_mcu,
+					       reboot_notifier);
+	int ret;
+
+	if (action != SYS_RESTART && action != SYS_POWER_OFF)
+		return NOTIFY_DONE;
+
+	/* Blank the panel before device_shutdown() stops its scanout. */
+	ret = backlight_disable(mcu->backlight);
+	if (ret)
+		dev_warn(&mcu->client->dev, "failed to blank backlight (%d)\n", ret);
+	return NOTIFY_DONE;
+}
+
+static int tanmatsu_poweroff_prepare(struct sys_off_data *data)
+{
+	struct i2c_client *client = data->cb_data;
+	u8 version[2], command[] = {126, 1}; /* power off, RTC alarm wake disabled */
+	int ret = tanmatsu_read(client, 0, version, sizeof(version));
+
+	if (!ret && (version[0] != TANMATSU_FW || version[1]))
+		ret = -EPROTONOSUPPORT;
+	if (!ret) {
+		ret = i2c_master_send(client, command, sizeof(command));
+		ret = ret == sizeof(command) ? 0 : (ret < 0 ? ret : -EIO);
+	}
+	if (ret)
+		dev_emerg(&client->dev, "MCU power-off failed (%d); system will halt cleanly\n", ret);
+	else {
+		/* Sleepable PREPARE stage: i2c-gpio may sleep. The MCU turns off
+		 * LEDs and both power inputs; never send I2C from the atomic hook.
+		 */
+		msleep(500);
+		dev_emerg(&client->dev, "still powered after MCU command; use power button\n");
+	}
+	return NOTIFY_DONE;
+}
+
+static int tanmatsu_poweroff_final(struct sys_off_data *data)
+{
+	/* Also used by RISC-V machine_halt(): no power request in this hook.
+	 * machine_power_off()/machine_halt() finish in the architecture WFI loop.
+	 */
+	return NOTIFY_DONE;
+}
+
+static ssize_t firmware_version_show(struct device *dev,
+				     struct device_attribute *attr, char *buf)
+{
+	u8 version[2];
+	int ret = tanmatsu_read(to_i2c_client(dev), 0, version, sizeof(version));
+
+	if (ret)
+		return ret;
+	return sysfs_emit(buf, "%u\n", version[0] | version[1] << 8);
+}
+static DEVICE_ATTR_RO(firmware_version);
+
+static ssize_t read_errors_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	struct tanmatsu_mcu *mcu = i2c_get_clientdata(to_i2c_client(dev));
+
+	return sysfs_emit(buf, "%u\n", READ_ONCE(mcu->read_errors));
+}
+static DEVICE_ATTR_RO(read_errors);
+
+static struct attribute *tanmatsu_attrs[] = {
+	&dev_attr_firmware_version.attr,
+	&dev_attr_read_errors.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(tanmatsu);
+
+static int tanmatsu_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct tanmatsu_mcu *mcu;
+	struct input_dev *input;
+	struct backlight_device *backlight;
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW, .max_brightness = 255, .brightness = 160,
+	};
+	unsigned int i;
+	int ret;
+	u8 version[2];
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C))
+		return -EOPNOTSUPP;
+	ret = tanmatsu_read(client, 0, version, sizeof(version));
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot read MCU firmware\n");
+	if (version[0] != TANMATSU_FW || version[1])
+		return dev_err_probe(dev, -EPROTONOSUPPORT,
+				     "MCU r%u unsupported; requires r9\n",
+				     version[0] | version[1] << 8);
+	mcu = devm_kzalloc(dev, sizeof(*mcu), GFP_KERNEL);
+	if (!mcu)
+		return -ENOMEM;
+	mcu->client = client;
+	mcu->volume_down = devm_gpiod_get_optional(dev, "volume-down", GPIOD_IN);
+	if (IS_ERR(mcu->volume_down))
+		return dev_err_probe(dev, PTR_ERR(mcu->volume_down), "volume GPIO\n");
+	i2c_set_clientdata(client, mcu);
+	input = devm_input_allocate_device(dev);
+	if (!input)
+		return -ENOMEM;
+	input->name = "Tanmatsu MCU keyboard";
+	input->phys = "tanmatsu-mcu/input0";
+	input->id.bustype = BUS_I2C;
+	input->id.version = TANMATSU_FW;
+	input_set_drvdata(input, mcu);
+	for (i = 0; i < ARRAY_SIZE(tanmatsu_keycodes); i++)
+		if (tanmatsu_keycodes[i] != KEY_RESERVED)
+			input_set_capability(input, EV_KEY, tanmatsu_keycodes[i]);
+	input_set_capability(input, EV_KEY, KEY_POWER);
+	input_set_capability(input, EV_KEY, KEY_VOLUMEDOWN);
+	input_set_capability(input, EV_SW, SW_HEADPHONE_INSERT);
+	__set_bit(EV_REP, input->evbit);
+	input_enable_softrepeat(input, 400, 50);
+	ret = input_setup_polling(input, tanmatsu_poll);
+	if (ret)
+		return ret;
+	input_set_poll_interval(input, 20);
+	input_set_min_poll_interval(input, 10);
+	input_set_max_poll_interval(input, 100);
+	ret = input_register_device(input);
+	if (ret)
+		return ret;
+	backlight = devm_backlight_device_register(dev, "tanmatsu", dev, client,
+						 &tanmatsu_backlight_ops, &props);
+	if (IS_ERR(backlight))
+		return dev_err_probe(dev, PTR_ERR(backlight), "backlight registration\n");
+	mcu->backlight = backlight;
+	ret = backlight_update_status(backlight);
+	if (ret)
+		dev_warn(dev, "initial backlight update failed: %d\n", ret);
+	ret = devm_register_sys_off_handler(dev, SYS_OFF_MODE_POWER_OFF_PREPARE,
+		SYS_OFF_PRIO_DEFAULT, tanmatsu_poweroff_prepare, client);
+	if (ret)
+		return ret;
+	ret = devm_register_sys_off_handler(dev, SYS_OFF_MODE_POWER_OFF,
+		SYS_OFF_PRIO_DEFAULT, tanmatsu_poweroff_final, client);
+	if (ret)
+		return ret;
+	mcu->reboot_notifier.notifier_call = tanmatsu_blank_on_shutdown;
+	ret = devm_register_reboot_notifier(dev, &mcu->reboot_notifier);
+	if (ret)
+		return ret;
+	dev_info(dev, "MCU r9 input: 20 ms polling, software repeat 400/50 ms\n");
+	return 0;
+}
+
+static const struct of_device_id tanmatsu_match[] = {
+	{ .compatible = "tanmatsu,management-mcu-r9" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, tanmatsu_match);
+static struct i2c_driver tanmatsu_driver = {
+	.driver = {
+		.name = "tanmatsu-mcu",
+		.of_match_table = tanmatsu_match,
+		.dev_groups = tanmatsu_groups,
+	},
+	.probe = tanmatsu_probe,
+};
+module_i2c_driver(tanmatsu_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Tanmatsu r9 management MCU keyboard and input");
