--- a/drivers/mmc/host/tanmatsu-sd.c
+++ b/drivers/mmc/host/tanmatsu-sd.c
@@ -0,0 +1,732 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Tanmatsu rev7, slot 0 only. ESP-IDF v6.0.2 SDMMC LL/registers are the
+ * hardware reference. Polled internal DMA with bounded image-sector writes: no IRQs,
+ * high-speed negotiation, voltage switching or radio/slot-1 transactions.
+ * The loader leaves LDO4 at 3.3V; check that contract before touching pins.
+ */
+#include <linux/capability.h>
+#include <linux/delay.h>
+#include <linux/mutex.h>
+#include <linux/dma-mapping.h>
+#include <linux/iopoll.h>
+#include <linux/mm.h>
+#include <linux/mmc/card.h>
+#include <linux/mmc/host.h>
+#include <linux/mmc/mmc.h>
+#include <linux/mmc/sd.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/scatterlist.h>
+#include <linux/workqueue.h>
+#include "dw_mmc.h"
+
+#define SD_RATE 40000000U
+#define SD_MAX_BLOCKS (PAGE_SIZE / 512)
+#define SD_ERRORS (SDMMC_INT_RESP_ERR | SDMMC_INT_RCRC | SDMMC_INT_DCRC | \
+	SDMMC_INT_RTO | SDMMC_INT_DRTO | SDMMC_INT_HTO | SDMMC_INT_FRUN | \
+	SDMMC_INT_HLE | SDMMC_INT_SBE | SDMMC_INT_EBE)
+
+#define SD_DMA_ERRORS (SDMMC_IDMAC_INT_FBE | SDMMC_IDMAC_INT_DU | \
+	SDMMC_IDMAC_INT_CES | SDMMC_IDMAC_INT_AI)
+#define SD_DESC_OWN BIT(31)
+#define SD_DESC_ERROR BIT(30)
+#define SD_DESC_FIRST BIT(3)
+#define SD_DESC_LAST BIT(2)
+#define SD_DESC_CHAIN BIT(4)
+
+/* ESP-IDF v6.0.2 P4 descriptor format: 16 hardware bytes, one cache line. */
+struct tanmatsu_sd_desc {
+	__le32 flags, size, buffer, next;
+	u32 reserved[12];
+} __aligned(64);
+
+#define SD_MAX_RANGES 64
+struct tanmatsu_sd_range { u64 start, count; };
+
+struct tanmatsu_sd {
+	struct mmc_host *mmc;
+	void __iomem *regs;
+	struct work_struct work;
+	struct mmc_request *mrq;
+	int ios_error;
+	bool init_clocks;
+	bool sector0_reported;
+	bool dma_error_reported;
+	bool dead;
+	struct mutex range_lock;
+	unsigned int nr_ranges;
+	struct tanmatsu_sd_range ranges[SD_MAX_RANGES];
+	bool data_mapped, desc_mapped;
+	struct device *dma_dev;
+	dma_addr_t data_dma, desc_dma;
+	u8 buffer[512] __aligned(64);
+	struct tanmatsu_sd_desc desc;
+
+};
+
+/* Privileged boot helper supplies allocated file sectors, never FAT metadata.
+ * The default is no writes. This is an accident guard for trusted NOMMU code.
+ */
+static bool tanmatsu_sd_writable(struct tanmatsu_sd *h, u32 arg)
+{
+	u64 sector = arg;
+	unsigned int i;
+	bool allowed = false;
+
+	if (!h->mmc->card)
+		return false;
+	if (!mmc_card_is_blockaddr(h->mmc->card)) {
+		if (arg & 511)
+			return false;
+		sector = arg / 512;
+	}
+	mutex_lock(&h->range_lock);
+	for (i = 0; i < h->nr_ranges; i++)
+		if (sector >= h->ranges[i].start &&
+		    sector - h->ranges[i].start < h->ranges[i].count) {
+			allowed = true;
+			break;
+		}
+	mutex_unlock(&h->range_lock);
+	return allowed;
+}
+
+static ssize_t write_ranges_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct mmc_host *mmc = dev_get_drvdata(dev);
+	struct tanmatsu_sd *h = mmc_priv(mmc);
+	struct tanmatsu_sd_range ranges[SD_MAX_RANGES];
+	unsigned int nr = 0, i;
+	unsigned long long start, length;
+	int used;
+	const char *p = buf;
+
+	if (!capable(CAP_SYS_RAWIO))
+		return -EPERM;
+	while (p < buf + count) {
+		if (nr == SD_MAX_RANGES || sscanf(p, "%llu %llu%n", &start, &length, &used) != 2 ||
+		    !start || !length || start > U32_MAX || length > U32_MAX - start)
+			return -EINVAL;
+		for (i = 0; i < nr; i++)
+			if (start < ranges[i].start + ranges[i].count &&
+			    ranges[i].start < start + length)
+				return -EINVAL;
+		ranges[nr++] = (struct tanmatsu_sd_range){ start, length };
+		p += used;
+		while (p < buf + count && (*p == '\n' || *p == ' '))
+			p++;
+	}
+	if (!nr)
+		return -EINVAL;
+	mutex_lock(&h->range_lock);
+	if (h->nr_ranges) {
+		/* Idempotent restart, never replace or widen the frozen gate. */
+		bool same = h->nr_ranges == nr &&
+			!memcmp(h->ranges, ranges, nr * sizeof(*ranges));
+
+		mutex_unlock(&h->range_lock);
+		return same ? (ssize_t)count : -EBUSY;
+	}
+	memcpy(h->ranges, ranges, nr * sizeof(*ranges));
+	h->nr_ranges = nr;
+	mutex_unlock(&h->range_lock);
+	return count;
+}
+static DEVICE_ATTR_WO(write_ranges);
+
+/* Only CMD24 can write; erase, lock, CMD25 and vendor commands stay denied. */
+static bool tanmatsu_sd_allowed(u32 opcode, struct mmc_data *data)
+{
+	if (data && (data->blocks != 1 || !data->blksz || data->blksz > 512))
+		return false;
+	if (opcode == MMC_WRITE_BLOCK)
+		return data && data->flags == MMC_DATA_WRITE && data->blksz == 512;
+	if (data && data->flags != MMC_DATA_READ)
+		return false;
+	switch (opcode) {
+	case MMC_GO_IDLE_STATE:
+	case MMC_ALL_SEND_CID:
+	case SD_SEND_RELATIVE_ADDR:
+	case MMC_SELECT_CARD:
+	case SD_SEND_IF_COND:
+	case MMC_SEND_CSD:
+	case MMC_SEND_CID:
+	case MMC_STOP_TRANSMISSION:
+	case MMC_SEND_STATUS:
+	case MMC_SET_BLOCKLEN:
+	case MMC_READ_SINGLE_BLOCK:
+	case MMC_APP_CMD:
+	case SD_APP_OP_COND:
+	case SD_APP_SEND_SCR:
+	case SD_SWITCH:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static int tanmatsu_sd_reset(struct tanmatsu_sd *h, u32 bits)
+{
+	u32 value;
+
+	writel(bits, h->regs + SDMMC_CTRL);
+	return readl_poll_timeout(h->regs + SDMMC_CTRL, value,
+				 !(value & bits), 10, 100000);
+}
+
+static int tanmatsu_sd_clock_update(struct tanmatsu_sd *h)
+{
+	u32 value;
+	int err;
+
+	writel(SDMMC_INT_HLE, h->regs + SDMMC_RINTSTS);
+	writel(SDMMC_CMD_START | SDMMC_CMD_UPD_CLK | SDMMC_CMD_PRV_DAT_WAIT,
+	       h->regs + SDMMC_CMD);
+	err = readl_poll_timeout(h->regs + SDMMC_CMD, value,
+				 !(value & SDMMC_CMD_START), 10, 100000);
+	if (!err && (readl(h->regs + SDMMC_RINTSTS) & SDMMC_INT_HLE))
+		err = -EIO;
+	return err;
+}
+
+/* Stop both the bus master and its interface before reclaiming CPU ownership.
+ * On a failed reset, pin the mapped host buffers and refuse further commands.
+ */
+static int tanmatsu_sd_dma_halt(struct tanmatsu_sd *h)
+{
+	u32 value;
+	int err;
+
+	writel(0, h->regs + SDMMC_CTRL);
+	writel(SDMMC_IDMAC_SWRESET, h->regs + SDMMC_BMOD);
+	err = readl_poll_timeout(h->regs + SDMMC_BMOD, value,
+				 !(value & SDMMC_IDMAC_SWRESET), 10, 100000);
+	if (!err)
+		err = tanmatsu_sd_reset(h, SDMMC_CTRL_DMA_RESET);
+	if (err)
+		h->dead = true;
+	return err;
+}
+
+static void tanmatsu_sd_dma_release(struct tanmatsu_sd *h)
+{
+	if (h->desc_mapped) {
+		dma_unmap_single(h->dma_dev, h->desc_dma, sizeof(h->desc), DMA_BIDIRECTIONAL);
+		h->desc_mapped = false;
+	}
+	if (h->data_mapped) {
+		dma_unmap_single(h->dma_dev, h->data_dma, sizeof(h->buffer), DMA_BIDIRECTIONAL);
+		h->data_mapped = false;
+	}
+}
+
+static int tanmatsu_sd_dma_map(struct tanmatsu_sd *h, struct device *dev)
+{
+	int err;
+
+	h->dma_dev = dev;
+	err = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (err)
+		return err;
+	h->data_dma = dma_map_single(dev, h->buffer, sizeof(h->buffer), DMA_BIDIRECTIONAL);
+	if (dma_mapping_error(dev, h->data_dma))
+		return -ENOMEM;
+	h->data_mapped = true;
+	h->desc_dma = dma_map_single(dev, &h->desc, sizeof(h->desc), DMA_BIDIRECTIONAL);
+	if (dma_mapping_error(dev, h->desc_dma)) {
+		tanmatsu_sd_dma_release(h);
+		return -ENOMEM;
+	}
+	h->desc_mapped = true;
+	/* P4 PSRAM is not coherent with IDMAC. RISC-V defaults to coherent
+	 * OF devices, so the board must explicitly declare dma-noncoherent.
+	 * Otherwise streaming sync calls silently skip our cache backend.
+	 */
+	if (!dma_need_sync(dev, h->desc_dma)) {
+		dev_err(dev, "IDMAC needs noncoherent DMA; check board dma-noncoherent\n");
+		tanmatsu_sd_dma_release(h);
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static void tanmatsu_sd_dma_prepare(struct tanmatsu_sd *h, unsigned int length, struct mmc_data *data, unsigned int offset)
+{
+	/* No live transaction exists here; mappings persist for the host lifetime.
+	 * Own complete 64-byte cache lines, separate from all host state.
+	 */
+	dma_sync_single_for_cpu(h->dma_dev, h->data_dma, sizeof(h->buffer), DMA_BIDIRECTIONAL);
+	dma_sync_single_for_cpu(h->dma_dev, h->desc_dma, sizeof(h->desc), DMA_BIDIRECTIONAL);
+	memset(h->buffer, 0xa5, sizeof(h->buffer));
+	if (data->flags == MMC_DATA_WRITE)
+		sg_pcopy_to_buffer(data->sg, data->sg_len, h->buffer, length, offset);
+	memset(&h->desc, 0, sizeof(h->desc));
+	h->desc.flags = cpu_to_le32(SD_DESC_OWN | SD_DESC_FIRST | SD_DESC_LAST | SD_DESC_CHAIN);
+	h->desc.size = cpu_to_le32(ALIGN(length, 4));
+	h->desc.buffer = cpu_to_le32(lower_32_bits(h->data_dma));
+	dma_sync_single_for_device(h->dma_dev, h->data_dma, sizeof(h->buffer), DMA_BIDIRECTIONAL);
+	dma_sync_single_for_device(h->dma_dev, h->desc_dma, sizeof(h->desc), DMA_BIDIRECTIONAL);
+	dma_wmb();
+	writel(~0U, h->regs + SDMMC_IDSTS);
+	writel(SDMMC_IDMAC_INT_NI | SDMMC_IDMAC_INT_RI | SDMMC_IDMAC_INT_TI,
+	       h->regs + SDMMC_IDINTEN);
+	writel(lower_32_bits(h->desc_dma), h->regs + SDMMC_DBADDR);
+	/* Match the pinned IDF LL order: interface, IDMAC selection, bus master.
+	 * CTRL global interrupt enable stays clear; completion is polled.
+	 */
+	writel(SDMMC_CTRL_DMA_ENABLE | SDMMC_CTRL_USE_IDMAC, h->regs + SDMMC_CTRL);
+	writel(SDMMC_IDMAC_FB | SDMMC_IDMAC_ENABLE, h->regs + SDMMC_BMOD);
+	writel(1, h->regs + SDMMC_PLDMND);
+}
+
+static void tanmatsu_sd_ios(struct mmc_host *mmc, struct mmc_ios *ios)
+{
+	struct tanmatsu_sd *h = mmc_priv(mmc);
+	u32 div;
+
+	mmc->actual_clock = 0;
+	writel(0, h->regs + SDMMC_CLKENA); /* Both slots off; slot 1 unused. */
+	h->ios_error = tanmatsu_sd_clock_update(h);
+	if (h->ios_error || !ios->clock || ios->power_mode == MMC_POWER_OFF)
+		return;
+	div = DIV_ROUND_UP(SD_RATE, 2 * ios->clock);
+	if (!div || div > 255) {
+		h->ios_error = -EINVAL;
+		return;
+	}
+	writel(div, h->regs + SDMMC_CLKDIV);
+	writel(0, h->regs + SDMMC_CLKSRC);
+	h->ios_error = tanmatsu_sd_clock_update(h);
+	if (h->ios_error)
+		return;
+	writel(ios->bus_width == MMC_BUS_WIDTH_4 ? SDMMC_CTYPE_4BIT : 0,
+	       h->regs + SDMMC_CTYPE);
+	writel(SDMMC_CLKEN_ENABLE, h->regs + SDMMC_CLKENA);
+	h->ios_error = tanmatsu_sd_clock_update(h);
+	if (!h->ios_error)
+		mmc->actual_clock = SD_RATE / (2 * div);
+	if (ios->power_mode == MMC_POWER_UP)
+		h->init_clocks = true;
+}
+
+/* FNV-1a is a diagnostic fingerprint, not authentication. */
+static u32 tanmatsu_sd_fingerprint(const u8 *bytes, unsigned int length)
+{
+	u32 value = 2166136261U;
+	unsigned int i;
+
+	for (i = 0; i < length; i++)
+		value = (value ^ bytes[i]) * 16777619U;
+	return value;
+}
+
+/* One deadline covers command, card data and DMA completion. No FIFO CPU reads. */
+static int tanmatsu_sd_transfer(struct tanmatsu_sd *h, struct mmc_command *cmd,
+			       unsigned int offset)
+{
+	struct mmc_data *data = cmd->data;
+	unsigned int length = data ? data->blksz : 0;
+	ktime_t deadline = ktime_add_ms(ktime_get(), 1000);
+	u32 flags = SDMMC_CMD_START | SDMMC_CMD_USE_HOLD_REG | cmd->opcode;
+	u32 status = 0, dma_status = 0, card_bytes = 0, host_bytes = 0;
+	u32 ctrl = 0, bmod = 0, base = 0, cur_desc = 0, cur_buf = 0;
+	u8 verify[512];
+	u32 raw_hash, copied_hash;
+	unsigned int nonzero, count;
+	bool cmd_done = false, data_done = !data;
+	int i, err = 0, halt_err;
+
+	if (h->dead)
+		return -EIO;
+	if (h->ios_error)
+		return h->ios_error;
+	if (!tanmatsu_sd_allowed(cmd->opcode, data))
+		return -EROFS;
+	if (data && data->flags == MMC_DATA_WRITE && !tanmatsu_sd_writable(h, cmd->arg))
+		return -EROFS;
+	if (data) {
+		if (data->flags == MMC_DATA_WRITE &&
+		    sg_pcopy_to_buffer(data->sg, data->sg_len, verify, length, offset) != length)
+			return -EIO;
+		if (!h->data_mapped || !h->desc_mapped)
+			return -EIO;
+		/* IDF may leave a suspended DMA engine behind on unmount. CTRL's
+		 * interface reset alone does not reset the internal bus master.
+		 * Rebase it explicitly before the first and every later command.
+		 */
+		err = tanmatsu_sd_dma_halt(h);
+		if (err)
+			return err;
+		err = tanmatsu_sd_reset(h, SDMMC_CTRL_FIFO_RESET);
+		if (err)
+			return err;
+		writel(length, h->regs + SDMMC_BLKSIZ);
+		writel(length, h->regs + SDMMC_BYTCNT);
+		tanmatsu_sd_dma_prepare(h, length, data, offset);
+		flags |= SDMMC_CMD_DAT_EXP;
+		if (data->flags == MMC_DATA_WRITE)
+			flags |= SDMMC_CMD_DAT_WR;
+	} else {
+		writel(0, h->regs + SDMMC_BYTCNT);
+	}
+	if (cmd->flags & MMC_RSP_PRESENT)
+		flags |= SDMMC_CMD_RESP_EXP;
+	if (cmd->flags & MMC_RSP_136)
+		flags |= SDMMC_CMD_RESP_LONG;
+	if (cmd->flags & MMC_RSP_CRC)
+		flags |= SDMMC_CMD_RESP_CRC;
+	if (cmd->opcode == MMC_STOP_TRANSMISSION)
+		flags |= SDMMC_CMD_STOP;
+	else if (cmd->opcode != MMC_SEND_STATUS)
+		flags |= SDMMC_CMD_PRV_DAT_WAIT;
+	if (h->init_clocks) {
+		flags |= SDMMC_CMD_INIT;
+		h->init_clocks = false;
+	}
+	writel(~0U, h->regs + SDMMC_RINTSTS);
+	writel(cmd->arg, h->regs + SDMMC_CMDARG);
+	writel(flags, h->regs + SDMMC_CMD);
+	for (;;) {
+		status = readl(h->regs + SDMMC_RINTSTS);
+		if (status & SD_ERRORS) {
+			if (status & (SDMMC_INT_RTO | SDMMC_INT_DRTO | SDMMC_INT_HTO))
+				err = -ETIMEDOUT;
+			else
+				err = status & (SDMMC_INT_RCRC | SDMMC_INT_DCRC) ? -EILSEQ : -EIO;
+			break;
+		}
+		cmd_done |= !!(status & SDMMC_INT_CMD_DONE);
+		data_done |= !!(status & SDMMC_INT_DATA_OVER);
+		if (data) {
+			dma_status = readl(h->regs + SDMMC_IDSTS);
+			card_bytes = readl(h->regs + SDMMC_TCBCNT);
+			host_bytes = readl(h->regs + SDMMC_TBBCNT);
+			if (dma_status & SD_DMA_ERRORS) {
+				err = -EIO;
+				break;
+			}
+		}
+		if (cmd_done && data_done &&
+		    (!data || ((dma_status & (data->flags == MMC_DATA_WRITE ? SDMMC_IDMAC_INT_TI : SDMMC_IDMAC_INT_RI)) &&
+		     card_bytes == length && host_bytes >= length &&
+		     host_bytes <= ALIGN(length, 4))) &&
+		    (!((cmd->flags & MMC_RSP_BUSY) || (data && data->flags == MMC_DATA_WRITE)) ||
+		     !(readl(h->regs + SDMMC_STATUS) & SDMMC_STATUS_BUSY)))
+			break;
+		if (ktime_compare(ktime_get(), deadline) >= 0) {
+			err = -ETIMEDOUT;
+			break;
+		}
+		cpu_relax();
+	}
+	if (data) {
+		/* Preserve the live engine registers before halt resets them. */
+		ctrl = readl(h->regs + SDMMC_CTRL);
+		bmod = readl(h->regs + SDMMC_BMOD);
+		base = readl(h->regs + SDMMC_DBADDR);
+		cur_desc = readl(h->regs + SDMMC_DSCADDR);
+		cur_buf = readl(h->regs + SDMMC_BUFADDR);
+		halt_err = tanmatsu_sd_dma_halt(h);
+		if (halt_err)
+			return halt_err; /* Device still owns mapped memory. */
+		dma_sync_single_for_cpu(h->dma_dev, h->desc_dma, sizeof(h->desc), DMA_BIDIRECTIONAL);
+		dma_sync_single_for_cpu(h->dma_dev, h->data_dma, sizeof(h->buffer), DMA_BIDIRECTIONAL);
+		dma_rmb();
+		if (!err && (le32_to_cpu(h->desc.flags) & (SD_DESC_OWN | SD_DESC_ERROR)))
+			err = -EIO;
+		if (err && !h->dma_error_reported) {
+			dev_err(mmc_dev(h->mmc),
+				"DMA transfer error=%d cmd=%u rint=%08x idsts=%08x desc=%08x card-bytes=%u host-bytes=%u ctrl=%08x bmod=%08x base=%08x current-desc=%08x current-buf=%08x\n",
+				err, cmd->opcode, status, dma_status, le32_to_cpu(h->desc.flags), card_bytes, host_bytes,
+				ctrl, bmod, base, cur_desc, cur_buf);
+			h->dma_error_reported = true;
+		}
+	}
+	if (err)
+		return err;
+	if (cmd->flags & MMC_RSP_136) {
+		for (i = 0; i < 4; i++)
+			cmd->resp[i] = readl(h->regs + SDMMC_RESP0 + 4 * (3 - i));
+	} else if (cmd->flags & MMC_RSP_PRESENT) {
+		cmd->resp[0] = readl(h->regs + SDMMC_RESP0);
+	}
+	if (data) {
+		if (data->flags == MMC_DATA_READ &&
+		    sg_pcopy_from_buffer(data->sg, data->sg_len, h->buffer, length, offset) != length)
+			return -EIO;
+		if (cmd->opcode == MMC_READ_SINGLE_BLOCK && !cmd->arg && length == 512) {
+			raw_hash = tanmatsu_sd_fingerprint(h->buffer, length);
+			if (sg_pcopy_to_buffer(data->sg, data->sg_len, verify, length, offset) != length)
+				return -EIO;
+			copied_hash = tanmatsu_sd_fingerprint(verify, length);
+			nonzero = 0;
+			for (count = 0; count < length; count++)
+				nonzero += h->buffer[count] != 0;
+			if (!h->sector0_reported) {
+				dev_info(mmc_dev(h->mmc),
+					"LBA0 dma=%08x sg=%08x nonzero=%u sig=%02x%02x idsts=%08x card-bytes=%u host-bytes=%u\n",
+					raw_hash, copied_hash, nonzero, h->buffer[510], h->buffer[511],
+					dma_status, card_bytes, host_bytes);
+				h->sector0_reported = true;
+			}
+			if (memcmp(h->buffer, verify, length))
+				return -EIO;
+			if (!nonzero)
+				return -EILSEQ;
+		}
+		data->bytes_xfered = length;
+	}
+	return 0;
+}
+
+/* The block layer requires at least PAGE_SIZE per request/segment. Accept
+ * page-sized reads, but keep every physical transaction a bounded CMD17.
+ * SDHC/SDXC command addresses count sectors; SDSC addresses count bytes.
+ */
+static int tanmatsu_sd_read_request(struct tanmatsu_sd *h, struct mmc_request *mrq)
+{
+	struct mmc_command *cmd = mrq->cmd;
+	struct mmc_data *data = mrq->data;
+	struct mmc_command one_cmd;
+	struct mmc_data one_data;
+	u32 step;
+	unsigned int block;
+	int err;
+
+	if (mrq->sbc)
+		return -EOPNOTSUPP;
+	if (cmd->opcode != MMC_READ_MULTIPLE_BLOCK && cmd->opcode != MMC_WRITE_MULTIPLE_BLOCK) {
+		if (mrq->stop)
+			return -EOPNOTSUPP;
+		return tanmatsu_sd_transfer(h, cmd, 0);
+	}
+	if (!data || cmd->data != data ||
+	    data->flags != (cmd->opcode == MMC_WRITE_MULTIPLE_BLOCK ? MMC_DATA_WRITE : MMC_DATA_READ))
+		return -EROFS;
+	data->bytes_xfered = 0;
+	if (data->blksz != 512 || data->blocks < 2 ||
+	    data->blocks > SD_MAX_BLOCKS || !h->mmc->card ||
+	    (mrq->stop && mrq->stop->opcode != MMC_STOP_TRANSMISSION))
+		return -EINVAL;
+	step = mmc_card_is_blockaddr(h->mmc->card) ? 1 : 512;
+	if (cmd->arg > U32_MAX - (data->blocks - 1) * step)
+		return -EINVAL;
+	one_data = *data;
+	one_data.blocks = 1;
+	one_cmd = *cmd;
+	one_cmd.opcode = data->flags == MMC_DATA_WRITE ? MMC_WRITE_BLOCK : MMC_READ_SINGLE_BLOCK;
+	one_cmd.data = &one_data;
+	for (block = 0; block < data->blocks; block++) {
+		one_cmd.arg = cmd->arg + block * step;
+		err = tanmatsu_sd_transfer(h, &one_cmd, block * 512);
+		memcpy(cmd->resp, one_cmd.resp, sizeof(cmd->resp));
+		if (err)
+			return err;
+		if (R1_STATUS(one_cmd.resp[0]))
+			return -EIO;
+	}
+	/* Only CMD17/CMD24 issued, so no physical CMD12 is needed. */
+	if (mrq->stop) {
+		mrq->stop->error = 0;
+		memset(mrq->stop->resp, 0, sizeof(mrq->stop->resp));
+	}
+	data->bytes_xfered = data->blocks * 512;
+	return 0;
+}
+
+static void tanmatsu_sd_work(struct work_struct *work)
+{
+	struct tanmatsu_sd *h = container_of(work, struct tanmatsu_sd, work);
+	struct mmc_request *mrq = h->mrq;
+	int err;
+
+	/* No CMD23 or physical multi-block command reaches hardware. */
+	err = tanmatsu_sd_read_request(h, mrq);
+	mrq->cmd->error = err;
+	if (mrq->data && err) {
+		mrq->data->error = err;
+		mrq->data->bytes_xfered = 0;
+	}
+	if (err && err != -EROFS && !h->dead) {
+		tanmatsu_sd_reset(h, SDMMC_CTRL_FIFO_RESET | SDMMC_CTRL_DMA_RESET);
+		writel(~0U, h->regs + SDMMC_RINTSTS);
+	}
+	mmc_request_done(h->mmc, mrq);
+}
+
+static void tanmatsu_sd_request(struct mmc_host *mmc, struct mmc_request *mrq)
+{
+	struct tanmatsu_sd *h = mmc_priv(mmc);
+
+	h->mrq = mrq;
+	schedule_work(&h->work);
+}
+
+static int tanmatsu_sd_ro(struct mmc_host *mmc)
+{
+	/* Requests are guarded by the frozen file-sector allowlist. */
+	return 0;
+}
+
+static const struct mmc_host_ops tanmatsu_sd_ops = {
+	.request = tanmatsu_sd_request,
+	.set_ios = tanmatsu_sd_ios,
+	.get_ro = tanmatsu_sd_ro,
+};
+
+static int tanmatsu_sd_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mmc_host *mmc;
+	struct tanmatsu_sd *h;
+	struct resource *mux_res;
+	void __iomem *clk, *power, *mux, *gpio;
+	u32 value;
+	int pin, err;
+
+	mmc = mmc_alloc_host(sizeof(*h), dev);
+	if (!mmc)
+		return -ENOMEM;
+	h = mmc_priv(mmc);
+	h->mmc = mmc;
+	h->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(h->regs)) {
+		err = PTR_ERR(h->regs);
+		goto free_host;
+	}
+	clk = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(clk)) {
+		err = PTR_ERR(clk);
+		goto free_host;
+	}
+	power = devm_platform_ioremap_resource(pdev, 2);
+	if (IS_ERR(power)) {
+		err = PTR_ERR(power);
+		goto free_host;
+	}
+	/* The GPIO provider reserves the whole IOMUX bank. SD owns only
+	 * GPIO39..44 within that bank, so map this subrange without a second
+	 * exclusive reservation, just like the shared GPIO registers below.
+	 */
+	mux_res = platform_get_resource(pdev, IORESOURCE_MEM, 3);
+	if (!mux_res) {
+		err = -EINVAL;
+		goto free_host;
+	}
+	mux = devm_ioremap(dev, mux_res->start, resource_size(mux_res));
+	/* Only per-pin SD registers and atomic W1TC enables are written. */
+	gpio = devm_ioremap(dev, 0x500e0000, 0x800);
+	if (!mux || !gpio) {
+		err = -ENOMEM;
+		goto free_host;
+	}
+	value = readl(power);
+	if ((value & (BIT(7) | BIT(8) | GENMASK(11, 9) | BIT(14))) !=
+	    (BIT(7) | BIT(8) | BIT(14))) {
+		err = dev_err_probe(dev, -EIO, "loader must retain LDO4 at 3.3V\n");
+		goto free_host;
+	}
+	/* PLL160M / 4 = 40MHz host clock. Preserve unrelated clock fields. */
+	writel(readl(clk) | BIT(14), clk); /* SOC_CLK_CTRL1 +0x18 */
+	value = readl(clk + 0x1c);
+	writel((value & ~(BIT(22) | BIT(23))) | BIT(24), clk + 0x1c);
+	value = readl(clk + 0x20) & ~GENMASK(29, 0);
+	value |= (3 << 9) | (1 << 13) | (3 << 17) | BIT(23) |
+		 BIT(27) | BIT(28) | BIT(29);
+	writel(value | BIT(8), clk + 0x20);
+	writel(value, clk + 0x20);
+	/* Slot-0 native IOMUX function 0, input on, 40mA drive, CMD/D pullups.
+	 * GPIO39..44 only; CLK43 has no pullup. No access to radio pins.
+	 */
+	writel(GENMASK(12, 7), gpio + 0x34);
+	for (pin = 39; pin <= 44; pin++) {
+		value = readl(mux + 4 * (pin - 39));
+		value &= ~(GENMASK(14, 12) | BIT(7) | BIT(1) | BIT(8));
+		value |= BIT(9) | (3 << 10);
+		if (pin != 43)
+			value |= BIT(8);
+		writel(value, mux + 4 * (pin - 39));
+		writel(0, gpio + 0x74 + 4 * pin);
+		writel(0, gpio + 0x558 + 4 * pin); /* peripheral output enable */
+	}
+	err = tanmatsu_sd_reset(h, SDMMC_CTRL_ALL_RESET_FLAGS);
+	if (err)
+		goto free_host;
+	writel(0, h->regs + SDMMC_INTMASK);
+	writel(0, h->regs + SDMMC_IDINTEN);
+	writel(0, h->regs + SDMMC_BMOD);
+	writel(0, h->regs + SDMMC_UHS_REG);
+	writel(0, h->regs + SDMMC_CDTHRCTL);
+	writel(~0U, h->regs + SDMMC_RINTSTS);
+	writel(~0U, h->regs + SDMMC_IDSTS);
+	writel(~0U, h->regs + SDMMC_TMOUT);
+	writel(SDMMC_SET_FIFOTH(0, 0, 0), h->regs + SDMMC_FIFOTH);
+	err = tanmatsu_sd_dma_map(h, dev);
+	if (err)
+		goto free_host;
+	mutex_init(&h->range_lock);
+	INIT_WORK(&h->work, tanmatsu_sd_work);
+	mmc->ops = &tanmatsu_sd_ops;
+	mmc->f_min = 100000;
+	mmc->f_max = 1000000;
+	mmc->ocr_avail = MMC_VDD_32_33 | MMC_VDD_33_34;
+	mmc->caps = MMC_CAP_4_BIT_DATA;
+	/* Card detect lives on the MCU; this stage scans once at boot. */
+	mmc->caps2 = MMC_CAP2_NO_SDIO | MMC_CAP2_NO_MMC;
+	mmc->max_segs = 1;
+	mmc->max_seg_size = PAGE_SIZE;
+	mmc->max_req_size = PAGE_SIZE;
+	mmc->max_blk_size = 512;
+	mmc->max_blk_count = SD_MAX_BLOCKS;
+	platform_set_drvdata(pdev, mmc);
+	err = mmc_add_host(mmc);
+	if (err)
+		goto free_host;
+	err = device_create_file(dev, &dev_attr_write_ranges);
+	if (err) {
+		mmc_remove_host(mmc);
+		goto free_host;
+	}
+	dev_info(dev, "slot 0 polled IDMAC, file-sector write gate, 1MHz maximum; no hotplug\n");
+	return 0;
+free_host:
+	tanmatsu_sd_dma_release(h);
+	mmc_free_host(mmc);
+	return err;
+}
+
+static void tanmatsu_sd_remove(struct platform_device *pdev)
+{
+	struct mmc_host *mmc = platform_get_drvdata(pdev);
+	struct tanmatsu_sd *h = mmc_priv(mmc);
+
+	device_remove_file(&pdev->dev, &dev_attr_write_ranges);
+	mmc_remove_host(mmc);
+	cancel_work_sync(&h->work);
+	if (tanmatsu_sd_dma_halt(h)) {
+		dev_err(&pdev->dev, "DMA halt failed; pinning mapped buffers until physical reset\n");
+		return;
+	}
+	tanmatsu_sd_dma_release(h);
+	writel(0, h->regs + SDMMC_CLKENA);
+	tanmatsu_sd_clock_update(h);
+	mmc_free_host(mmc);
+}
+
+static const struct of_device_id tanmatsu_sd_match[] = {
+	{ .compatible = "tanmatsu,rev7-sd" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, tanmatsu_sd_match);
+static struct platform_driver tanmatsu_sd_driver = {
+	.probe = tanmatsu_sd_probe,
+	.remove = tanmatsu_sd_remove,
+	.driver = {
+		.name = "tanmatsu-sd",
+		.of_match_table = tanmatsu_sd_match,
+	},
+};
+module_platform_driver(tanmatsu_sd_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Tanmatsu rev7 bounded-write slot-0 SD host");
