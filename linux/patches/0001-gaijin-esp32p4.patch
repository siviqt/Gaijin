--- a/drivers/gpio/gpio-tanmatsu.c
+++ b/drivers/gpio/gpio-tanmatsu.c
@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Tanmatsu rev7 M2: only internal I2C and volume-down GPIOs.
+ * Register definitions checked against ESP-IDF v6.0.2 ESP32-P4 headers.
+ * No GPIO IRQ controller, clock reset or access to SD/radio/USB pins.
+ */
+#include <linux/bitmap.h>
+#include <linux/gpio/driver.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+struct tanmatsu_gpio {
+	struct gpio_chip chip;
+	void __iomem *gpio;
+	void __iomem *mux;
+	void __iomem *lp_mux;
+};
+
+static int tanmatsu_gpio_input(struct gpio_chip *chip, unsigned int pin)
+{
+	struct tanmatsu_gpio *g = gpiochip_get_data(chip);
+
+	writel(BIT(pin % 32), g->gpio + (pin < 32 ? 0x28 : 0x34));
+	return 0;
+}
+
+static int tanmatsu_gpio_request(struct gpio_chip *chip, unsigned int pin)
+{
+	struct tanmatsu_gpio *g = gpiochip_get_data(chip);
+	void __iomem *reg = g->mux + 4 + 4 * pin;
+	u32 value;
+
+	/* Disable output first, then detach the previous peripheral. */
+	tanmatsu_gpio_input(chip, pin);
+	if (pin < 16) {
+		value = readl(g->lp_mux + 8 + 4 * pin);
+		writel(value & ~BIT(4), g->lp_mux + 8 + 4 * pin);
+	}
+	/* GPIO function 1, input on, pull-up on, no sleep override/pull-down. */
+	value = readl(reg);
+	value &= ~((7 << 12) | BIT(7) | BIT(1));
+	writel(value | BIT(12) | BIT(9) | BIT(8), reg);
+	/* No inherited IRQ or hardware open drain: gpiolib emulates OD. */
+	writel(0, g->gpio + 0x74 + 4 * pin);
+	writel(256 | BIT(10), g->gpio + 0x558 + 4 * pin);
+	return 0;
+}
+
+static int tanmatsu_gpio_set(struct gpio_chip *chip, unsigned int pin, int value)
+{
+	struct tanmatsu_gpio *g = gpiochip_get_data(chip);
+	unsigned int offset = pin < 32 ? 0x08 : 0x14;
+
+	if (pin == 35)
+		return -EINVAL;
+	writel(BIT(pin % 32), g->gpio + offset + (value ? 0 : 4));
+	return 0;
+}
+
+static int tanmatsu_gpio_output(struct gpio_chip *chip, unsigned int pin, int value)
+{
+	struct tanmatsu_gpio *g = gpiochip_get_data(chip);
+	int ret = tanmatsu_gpio_set(chip, pin, value);
+
+	if (ret)
+		return ret;
+	writel(BIT(pin % 32), g->gpio + (pin < 32 ? 0x24 : 0x30));
+	return 0;
+}
+
+static int tanmatsu_gpio_get(struct gpio_chip *chip, unsigned int pin)
+{
+	struct tanmatsu_gpio *g = gpiochip_get_data(chip);
+
+	return !!(readl(g->gpio + (pin < 32 ? 0x3c : 0x40)) & BIT(pin % 32));
+}
+
+static int tanmatsu_gpio_direction(struct gpio_chip *chip, unsigned int pin)
+{
+	struct tanmatsu_gpio *g = gpiochip_get_data(chip);
+
+	return !(readl(g->gpio + (pin < 32 ? 0x20 : 0x2c)) & BIT(pin % 32));
+}
+
+static int tanmatsu_gpio_valid(struct gpio_chip *chip, unsigned long *mask,
+			     unsigned int ngpios)
+{
+	bitmap_zero(mask, ngpios);
+	__set_bit(9, mask);
+	__set_bit(10, mask);
+	__set_bit(35, mask);
+	return 0;
+}
+
+static void tanmatsu_gpio_free(struct gpio_chip *chip, unsigned int pin)
+{
+	tanmatsu_gpio_input(chip, pin);
+}
+
+static int tanmatsu_gpio_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct tanmatsu_gpio *g;
+
+	g = devm_kzalloc(dev, sizeof(*g), GFP_KERNEL);
+	if (!g)
+		return -ENOMEM;
+	g->gpio = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(g->gpio))
+		return PTR_ERR(g->gpio);
+	g->mux = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(g->mux))
+		return PTR_ERR(g->mux);
+	g->lp_mux = devm_platform_ioremap_resource(pdev, 2);
+	if (IS_ERR(g->lp_mux))
+		return PTR_ERR(g->lp_mux);
+	g->chip = (struct gpio_chip) {
+		.label = "tanmatsu-m2-gpio",
+		.parent = dev,
+		.owner = THIS_MODULE,
+		.base = -1,
+		.ngpio = 36,
+		.request = tanmatsu_gpio_request,
+		.free = tanmatsu_gpio_free,
+		.init_valid_mask = tanmatsu_gpio_valid,
+		.get_direction = tanmatsu_gpio_direction,
+		.direction_input = tanmatsu_gpio_input,
+		.direction_output = tanmatsu_gpio_output,
+		.get = tanmatsu_gpio_get,
+		.set = tanmatsu_gpio_set,
+	};
+	return devm_gpiochip_add_data(dev, &g->chip, g);
+}
+
+static const struct of_device_id tanmatsu_gpio_match[] = {
+	{ .compatible = "tanmatsu,rev7-m2-gpio" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, tanmatsu_gpio_match);
+
+static struct platform_driver tanmatsu_gpio_driver = {
+	.probe = tanmatsu_gpio_probe,
+	.driver = {
+		.name = "tanmatsu-m2-gpio",
+		.of_match_table = tanmatsu_gpio_match,
+	},
+};
+module_platform_driver(tanmatsu_gpio_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Tanmatsu rev7 limited GPIO support for M2");
