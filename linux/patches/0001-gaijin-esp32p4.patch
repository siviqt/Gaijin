--- a/drivers/power/reset/tanmatsu-power.c
+++ b/drivers/power/reset/tanmatsu-power.c
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Tanmatsu rev7 reset to AppFS Launcher using ESP32-P4 ROM software_reset. */
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/reboot.h>
+
+#define RTC_CUSTOM_BYTES 256
+struct tanmatsu_power {
+	void __iomem *retained;
+};
+
+static int tanmatsu_restart(struct sys_off_data *data)
+{
+	struct tanmatsu_power *power = data->cb_data;
+
+	/* Clear AppFS magic before reset so the bootloader selects Launcher. */
+	writel(0, power->retained);
+	writel(0, power->retained + 4);
+	wmb();
+	local_irq_disable();
+	/* Full digital-system reset from ROM, never an IDF/FreeRTOS call.
+	 * The ROM executes outside PSRAM while resetting CPUs/peripherals.
+	 */
+	((void (*)(void))0x4fc00094UL)();
+	pr_emerg("Tanmatsu ROM reset returned; use physical reset\n");
+	return NOTIFY_DONE;
+}
+
+static ssize_t ready_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "1\n");
+}
+static DEVICE_ATTR_RO(ready);
+static struct attribute *tanmatsu_power_attrs[] = {
+	&dev_attr_ready.attr, NULL,
+};
+ATTRIBUTE_GROUPS(tanmatsu_power);
+
+static int tanmatsu_power_probe(struct platform_device *pdev)
+{
+	struct tanmatsu_power *power;
+	struct resource *res;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res || res->start != 0x5010800c || resource_size(res) != RTC_CUSTOM_BYTES)
+		return -EINVAL;
+	power = devm_kzalloc(&pdev->dev, sizeof(*power), GFP_KERNEL);
+	if (!power)
+		return -ENOMEM;
+	power->retained = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(power->retained))
+		return PTR_ERR(power->retained);
+	dev_info(&pdev->dev, "Launcher reset ready\n");
+	return devm_register_sys_off_handler(&pdev->dev, SYS_OFF_MODE_RESTART,
+		SYS_OFF_PRIO_FIRMWARE, tanmatsu_restart, power);
+}
+static const struct of_device_id tanmatsu_power_match[] = {
+	{ .compatible = "tanmatsu,rev7-power" }, { }
+};
+static struct platform_driver tanmatsu_power_driver = {
+	.driver = { .name = "tanmatsu-power", .of_match_table = tanmatsu_power_match,
+		.dev_groups = tanmatsu_power_groups },
+	.probe = tanmatsu_power_probe,
+};
+builtin_platform_driver(tanmatsu_power_driver);
+MODULE_LICENSE("GPL");
