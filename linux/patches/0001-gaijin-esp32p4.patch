--- a/mm/nommu_userspace_pool.c
+++ b/mm/nommu_userspace_pool.c
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Reserved-memory pool for large NOMMU user-space mmap allocations.
+ *
+ * On NOMMU, every private mmap (fork+exec, anonymous malloc, brk-grown
+ * heap) is satisfied by ONE physically contiguous page range. The
+ * buddy allocator fragments quickly on small (tens of MB) NOMMU
+ * machines, leaving plenty of nominal free memory but no free blocks
+ * of the order a non-trivial fork+exec needs. CONFIG_CMA — the
+ * standard answer — depends on MMU.
+ *
+ * This file implements a small generic mechanism: a DT-described
+ * reserved range, served by a gen_pool, that the NOMMU mmap path
+ * draws from before falling back to alloc_pages_exact(). See
+ * Documentation/devicetree/bindings/reserved-memory/
+ * linux,nommu-userspace-pool.yaml for the binding.
+ */
+
+#define pr_fmt(fmt) "nommu_userspace_pool: " fmt
+
+#include <linux/genalloc.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/mm.h>
+#include <linux/nommu_userspace_pool.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/printk.h>
+#include <linux/sizes.h>
+
+static struct gen_pool *user_pool;
+
+/*
+ * Captured at early-boot RESERVEDMEM_OF_DECLARE time and consumed by
+ * the core_initcall that actually builds the gen_pool — gen_pool_create
+ * needs the slab allocator, which is not yet available when reserved
+ * memory regions are first parsed.
+ */
+static phys_addr_t pool_phys __initdata;
+static size_t pool_size __initdata;
+
+void *nommu_userspace_pool_alloc(size_t size)
+{
+	unsigned long va;
+
+	if (!user_pool || !size)
+		return NULL;
+
+	va = gen_pool_alloc(user_pool, size);
+	return (void *)va; /* 0 → NULL on failure, which is what we want */
+}
+
+void nommu_userspace_pool_free(void *addr, size_t size)
+{
+	if (!user_pool || !addr)
+		return;
+	gen_pool_free(user_pool, (unsigned long)addr, size);
+}
+
+static int __init nommu_userspace_pool_init(void)
+{
+	void *va;
+	int ret;
+
+	if (!pool_size)
+		return 0;
+
+	user_pool = gen_pool_create(PAGE_SHIFT, NUMA_NO_NODE);
+	if (!user_pool) {
+		pr_err("gen_pool_create failed\n");
+		return -ENOMEM;
+	}
+
+	/*
+	 * Reserved-memory regions registered via RESERVEDMEM_OF_DECLARE
+	 * are excluded from the buddy allocator (memblock_reserve) but
+	 * remain part of the kernel direct map and have struct pages.
+	 * phys_to_virt is therefore the right address translation here;
+	 * no ioremap is needed and the memory is cached, matching how
+	 * userspace expects to see its text/data.
+	 */
+	va = phys_to_virt(pool_phys);
+
+	ret = gen_pool_add_virt(user_pool, (unsigned long)va, pool_phys,
+				pool_size, NUMA_NO_NODE);
+	if (ret) {
+		pr_err("gen_pool_add_virt failed: %d\n", ret);
+		gen_pool_destroy(user_pool);
+		user_pool = NULL;
+		return ret;
+	}
+
+	pr_info("%zu KiB at %pa serves NOMMU user mmap allocations\n",
+		pool_size / SZ_1K, &pool_phys);
+	return 0;
+}
+core_initcall(nommu_userspace_pool_init);
+
+static int __init nommu_userspace_pool_rmem(struct reserved_mem *rmem)
+{
+	if (pool_size) {
+		pr_warn("multiple pool regions declared; ignoring %pa\n",
+			&rmem->base);
+		return -EINVAL;
+	}
+
+	pool_phys = rmem->base;
+	pool_size = rmem->size;
+	pr_info("reserved %zu KiB at %pa for user mmap allocations\n",
+		pool_size / SZ_1K, &pool_phys);
+	return 0;
+}
+RESERVEDMEM_OF_DECLARE(nommu_userspace_pool, "linux,nommu-userspace-pool",
+		       nommu_userspace_pool_rmem);
--- a/drivers/video/fbdev/tanmatsu-fb.c
+++ b/drivers/video/fbdev/tanmatsu-fb.c
@@ -0,0 +1,298 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Tanmatsu rev7 ST7701: loader configures DSI/PHY and DW-GDMA channel 0.
+ * Linux owns all refresh interrupts; no IDF ISR or descriptor survives in use.
+ * Register layout: pinned ESP-IDF v6.0.2 P4 DW-GDMA LL/register headers.
+ */
+#include <linux/dma-map-ops.h>
+#include <linux/fb.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of_address.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+#include <linux/workqueue.h>
+
+#define FB_BASE 0x48e00000U
+#define FB_BYTES (480U * 800U * 2U)
+#define FB_RESERVE 0xbc000U
+#define FB_FLUSH_CHUNK 4096U
+#define DESC_BASE (FB_BASE + FB_BYTES)
+#define DESC_BYTES 64
+#define DMA_CHEN 0x18
+#define DMA_LLP 0x128
+#define DMA_STATUS_EN 0x180
+#define DMA_STATUS 0x188
+#define DMA_SIGNAL_EN 0x190
+#define DMA_CLEAR 0x198
+#define DMA_DONE BIT(1)
+#define DMA_ERRORS GENMASK(13, 5)
+#define DMA_EVENTS (DMA_DONE | DMA_ERRORS)
+
+struct tanmatsu_fb {
+	struct fb_info *info;
+	void __iomem *dma;
+	void __iomem *bridge;
+	u32 *desc;
+	u32 descriptor[DESC_BYTES / sizeof(u32)];
+	u32 palette[16];
+	struct delayed_work flush;
+	atomic_t frames, errors, underruns;
+	int irq;
+};
+
+static void tanmatsu_fb_start(struct tanmatsu_fb *fb)
+{
+	/* Hardware clears LLI_VALID in memory. Discard that DMA write before
+	 * rebuilding the entire cache line, then publish L1D -> L2 -> PSRAM.
+	 */
+	arch_sync_dma_for_cpu(DESC_BASE, DESC_BYTES, DMA_FROM_DEVICE);
+	memcpy(fb->desc, fb->descriptor, DESC_BYTES);
+	arch_sync_dma_for_device(DESC_BASE, DESC_BYTES, DMA_TO_DEVICE);
+	writel(DESC_BASE | 1, fb->dma + DMA_LLP); /* LLP master 1 = memory */
+	writel(0, fb->dma + DMA_LLP + 4);
+	wmb();
+	writel(0x101, fb->dma + DMA_CHEN);
+}
+
+static irqreturn_t tanmatsu_fb_irq(int irq, void *data)
+{
+	struct tanmatsu_fb *fb = data;
+	u32 status = readl(fb->dma + DMA_STATUS);
+
+	if (!(status & DMA_EVENTS))
+		return IRQ_NONE;
+	writel(status, fb->dma + DMA_CLEAR);
+	if (status & DMA_ERRORS) {
+		/* Stop on bus/descriptor errors. Never spin in an IRQ retry loop. */
+		writel(0, fb->dma + DMA_SIGNAL_EN);
+		writel(0x100, fb->dma + DMA_CHEN);
+		atomic_inc(&fb->errors);
+		dev_err_ratelimited(fb->info->device, "display DMA stopped: %#x\n", status);
+	} else if (status & DMA_DONE) {
+		atomic_inc(&fb->frames);
+		tanmatsu_fb_start(fb);
+	}
+	return IRQ_HANDLED;
+}
+
+static void tanmatsu_fb_flush(struct work_struct *work)
+{
+	struct tanmatsu_fb *fb = container_of(to_delayed_work(work), struct tanmatsu_fb, flush);
+	unsigned int offset;
+
+	/* This 20 Hz writeback covers fbcon and /dev/fb0 writes. The ROM masks
+	 * IRQs during each writeback, so limit each range to let the frame IRQ
+	 * re-arm scanout between calls.
+	 */
+	for (offset = 0; offset < FB_BYTES; offset += FB_FLUSH_CHUNK)
+		arch_sync_dma_for_device(FB_BASE + offset,
+					 min(FB_BYTES - offset, FB_FLUSH_CHUNK),
+					 DMA_TO_DEVICE);
+	if (readl(fb->bridge + 0x58) & BIT(0)) {
+		writel(BIT(0), fb->bridge + 0x54);
+		atomic_inc(&fb->underruns);
+		dev_warn_ratelimited(fb->info->device, "DSI FIFO underrun\n");
+	}
+	schedule_delayed_work(&fb->flush, msecs_to_jiffies(50));
+}
+
+static int tanmatsu_fb_check_var(struct fb_var_screeninfo *var, struct fb_info *info)
+{
+	if (var->xres != 480 || var->yres != 800 ||
+	    var->xres_virtual != 480 || var->yres_virtual != 800 ||
+	    var->bits_per_pixel != 16 || var->xoffset || var->yoffset ||
+	    var->nonstd || var->grayscale || var->vmode != FB_VMODE_NONINTERLACED)
+		return -EINVAL;
+	var->red = info->var.red;
+	var->green = info->var.green;
+	var->blue = info->var.blue;
+	var->transp = info->var.transp;
+	return 0;
+}
+
+static int tanmatsu_fb_setcolreg(unsigned int reg, unsigned int red,
+		unsigned int green, unsigned int blue, unsigned int transp,
+		struct fb_info *info)
+{
+	struct tanmatsu_fb *fb = info->par;
+
+	if (reg >= ARRAY_SIZE(fb->palette))
+		return -EINVAL;
+	fb->palette[reg] = ((red >> 11) << 11) | ((green >> 10) << 5) | (blue >> 11);
+	return 0;
+}
+
+static void tanmatsu_fb_destroy(struct fb_info *info)
+{
+	/* Existing /dev/fb0 users keep info alive after driver unbind. The
+	 * reserved pixel memory outlives the device and is never freed here.
+	 */
+	framebuffer_release(info);
+}
+
+static const struct fb_ops tanmatsu_fb_ops = {
+	.owner = THIS_MODULE,
+	__FB_DEFAULT_SYSMEM_OPS_RDWR,
+	__FB_DEFAULT_SYSMEM_OPS_DRAW,
+	.fb_destroy = tanmatsu_fb_destroy,
+	.fb_check_var = tanmatsu_fb_check_var,
+	.fb_setcolreg = tanmatsu_fb_setcolreg,
+};
+
+static ssize_t frames_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct tanmatsu_fb *fb = platform_get_drvdata(to_platform_device(dev));
+	return sysfs_emit(buf, "%d\n", atomic_read(&fb->frames));
+}
+static DEVICE_ATTR_RO(frames);
+
+static ssize_t dma_errors_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct tanmatsu_fb *fb = platform_get_drvdata(to_platform_device(dev));
+	return sysfs_emit(buf, "%d\n", atomic_read(&fb->errors));
+}
+static DEVICE_ATTR_RO(dma_errors);
+
+static ssize_t underruns_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct tanmatsu_fb *fb = platform_get_drvdata(to_platform_device(dev));
+	return sysfs_emit(buf, "%d\n", atomic_read(&fb->underruns));
+}
+static DEVICE_ATTR_RO(underruns);
+
+static struct attribute *tanmatsu_fb_attrs[] = {
+	&dev_attr_frames.attr, &dev_attr_dma_errors.attr, &dev_attr_underruns.attr, NULL,
+};
+ATTRIBUTE_GROUPS(tanmatsu_fb);
+
+static int tanmatsu_fb_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np;
+	struct reserved_mem *mem;
+	struct fb_info *info;
+	struct tanmatsu_fb *fb;
+	int ret;
+
+	np = of_parse_phandle(dev->of_node, "memory-region", 0);
+	if (!np)
+		return -EINVAL;
+	mem = of_reserved_mem_lookup(np);
+	of_node_put(np);
+	if (!mem || mem->base != FB_BASE || mem->size != FB_RESERVE)
+		return dev_err_probe(dev, -EINVAL, "missing reserved display memory\n");
+	info = framebuffer_alloc(sizeof(*fb), dev);
+	if (!info)
+		return -ENOMEM;
+	fb = info->par;
+	fb->info = info;
+	fb->dma = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(fb->dma)) {
+		ret = PTR_ERR(fb->dma);
+		goto release;
+	}
+	fb->bridge = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(fb->bridge)) {
+		ret = PTR_ERR(fb->bridge);
+		goto release;
+	}
+	fb->desc = phys_to_virt(DESC_BASE);
+	arch_sync_dma_for_cpu(DESC_BASE, DESC_BYTES, DMA_FROM_DEVICE);
+	memcpy(fb->descriptor, fb->desc, DESC_BYTES);
+	/* Refuse stale loaders, active DMA and an incompatible handoff. */
+	if (fb->descriptor[0] != FB_BASE || fb->descriptor[1] ||
+	    fb->descriptor[2] != 0x50105000 || fb->descriptor[3] ||
+	    fb->descriptor[4] != FB_BYTES / 8 - 1 ||
+	    fb->descriptor[6] || fb->descriptor[7] ||
+	    (fb->descriptor[9] & (BIT(30) | BIT(31))) != (BIT(30) | BIT(31)) ||
+	    (readl(fb->dma + DMA_CHEN) & BIT(0))) {
+		ret = dev_err_probe(dev, -EINVAL, "invalid loader display handoff\n");
+		goto release;
+	}
+	info->fix = (struct fb_fix_screeninfo) {
+		.id = "tanmatsu", .smem_start = FB_BASE, .smem_len = FB_BYTES,
+		.type = FB_TYPE_PACKED_PIXELS, .visual = FB_VISUAL_TRUECOLOR,
+		.line_length = 480 * 2, .accel = FB_ACCEL_NONE,
+	};
+	info->var = (struct fb_var_screeninfo) {
+		.xres = 480, .yres = 800, .xres_virtual = 480, .yres_virtual = 800,
+		.bits_per_pixel = 16, .red = {11, 5, 0}, .green = {5, 6, 0},
+		.blue = {0, 5, 0}, .height = -1, .width = -1,
+		.activate = FB_ACTIVATE_NOW, .vmode = FB_VMODE_NONINTERLACED,
+	};
+	info->screen_buffer = phys_to_virt(FB_BASE);
+	info->screen_size = FB_BYTES;
+	info->flags = FBINFO_VIRTFB;
+	info->fbops = &tanmatsu_fb_ops;
+	info->pseudo_palette = fb->palette;
+	fb->irq = platform_get_irq(pdev, 0);
+	if (fb->irq < 0) {
+		ret = fb->irq;
+		goto release;
+	}
+	writel(0, fb->dma + DMA_SIGNAL_EN);
+	writel(~0U, fb->dma + DMA_CLEAR);
+	ret = devm_request_irq(dev, fb->irq, tanmatsu_fb_irq, 0, dev_name(dev), fb);
+	if (ret)
+		goto release;
+	platform_set_drvdata(pdev, fb);
+	INIT_DELAYED_WORK(&fb->flush, tanmatsu_fb_flush);
+	ret = register_framebuffer(info);
+	if (ret) {
+		devm_free_irq(dev, fb->irq, fb);
+		goto release;
+	}
+	arch_sync_dma_for_device(FB_BASE, FB_BYTES, DMA_TO_DEVICE);
+	writel(DMA_EVENTS, fb->dma + DMA_STATUS_EN);
+	writel(DMA_EVENTS, fb->dma + DMA_SIGNAL_EN);
+	writel(~0U, fb->bridge + 0x54);
+	tanmatsu_fb_start(fb);
+	/* First enable scanout with DMA already armed. Keeping DPI disabled
+	 * through kernel startup prevents an underrun before this probe.
+	 */
+	writel(readl(fb->bridge + 0x40) | BIT(0), fb->bridge + 0x40);
+	writel(1, fb->bridge + 0x44);
+	schedule_delayed_work(&fb->flush, msecs_to_jiffies(50));
+	dev_info(dev, "fb%d: 480x800 RGB565, landscape fbcon, 20 Hz cache flush\n", info->node);
+	return 0;
+release:
+	framebuffer_release(info);
+	return ret;
+}
+
+static void tanmatsu_fb_shutdown(struct platform_device *pdev)
+{
+	struct tanmatsu_fb *fb = platform_get_drvdata(pdev);
+
+	writel(readl(fb->bridge + 0x40) & ~BIT(0), fb->bridge + 0x40);
+	writel(1, fb->bridge + 0x44);
+	writel(0, fb->dma + DMA_SIGNAL_EN);
+	disable_irq(fb->irq);
+	writel(0x100, fb->dma + DMA_CHEN);
+	cancel_delayed_work_sync(&fb->flush);
+}
+
+static void tanmatsu_fb_remove(struct platform_device *pdev)
+{
+	struct tanmatsu_fb *fb = platform_get_drvdata(pdev);
+
+	tanmatsu_fb_shutdown(pdev);
+	devm_free_irq(&pdev->dev, fb->irq, fb);
+	unregister_framebuffer(fb->info);
+}
+
+static const struct of_device_id tanmatsu_fb_match[] = {
+	{ .compatible = "tanmatsu,rev7-fb" }, { }
+};
+MODULE_DEVICE_TABLE(of, tanmatsu_fb_match);
+static struct platform_driver tanmatsu_fb_driver = {
+	.driver = { .name = "tanmatsu-fb", .of_match_table = tanmatsu_fb_match,
+		    .dev_groups = tanmatsu_fb_groups },
+	.probe = tanmatsu_fb_probe,
+	.remove = tanmatsu_fb_remove,
+	.shutdown = tanmatsu_fb_shutdown,
+};
+module_platform_driver(tanmatsu_fb_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Tanmatsu loader-initialized DSI framebuffer and native refresh");
