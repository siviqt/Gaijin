--- a/drivers/irqchip/irq-esp32p4-clic.c
+++ b/drivers/irqchip/irq-esp32p4-clic.c
@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ESP32-P4 CLIC (Core-Local Interrupt Controller) irqchip driver.
+ *
+ * Per-slot trigger mode via 3-cell DTS specifier:
+ *   <clic_slot intmtx_source IRQ_TYPE_*>
+ *   cell[2] omitted or IRQ_TYPE_NONE → level-high (default).
+ *   IRQ_TYPE_EDGE_RISING → rising-edge, handle_edge_irq.
+ *   IRQ_TYPE_LEVEL_HIGH  → level,       handle_level_irq.
+ *
+ * Note: clic_irq_set_type programs clicintattr only. It does NOT
+ * change the flow handler — drivers that install handle_percpu_devid_irq
+ * (SYSTIMER) via irq_set_chip_and_handler() must keep that setting,
+ * but __setup_irq invokes chip->irq_set_type, which would otherwise
+ * clobber it back to handle_edge_irq/handle_level_irq. The initial
+ * flow handler is set once in clic_domain_map based on the cached
+ * xlate trigger.
+ */
+
+#define pr_fmt(fmt) "esp32p4-clic: " fmt
+
+#include <linux/irq.h>
+#include <linux/irqchip.h>
+#include <linux/io.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+
+#define CLIC_NUM_IRQS     240
+#define CLIC_INTIP_OFF      0
+#define CLIC_INTIE_OFF      1
+#define CLIC_INTATTR_OFF    2
+#define CLIC_INTCTL_OFF     3
+
+#define CLIC_INTATTR_MMODE_LEVEL 0xC0U
+#define CLIC_INTATTR_MMODE_EDGE  0xC2U
+#define CLIC_INTCTL_MAX          0xFFU
+
+static void __iomem *clic_base;
+static void __iomem *clic_intmtx_base;
+
+static u8 clic_intmtx_source[CLIC_NUM_IRQS];
+static u8 clic_trig_edge[CLIC_NUM_IRQS];
+
+struct irq_domain *esp32p4_clic_domain;
+EXPORT_SYMBOL_GPL(esp32p4_clic_domain);
+
+static void clic_irq_mask(struct irq_data *d)
+{
+	writeb(0, clic_base + d->hwirq * 4 + CLIC_INTIE_OFF);
+}
+
+static void clic_irq_unmask(struct irq_data *d)
+{
+	writeb(1, clic_base + d->hwirq * 4 + CLIC_INTIE_OFF);
+}
+
+static void clic_irq_ack(struct irq_data *d)
+{
+	/*
+	 * Per CLIC spec, INTIP on a level-triggered slot mirrors the source
+	 * line: software writes are nominally no-ops. In practice we've seen
+	 * non-deterministic TX stalls on UART0 (level-mode) that are consistent
+	 * with the write-0 here disturbing a pending latch when the sequence
+	 * is: mask_ack (this write, source still high) → handler clears
+	 * source in peripheral → unmask. Gate the write on edge-mode only,
+	 * which is all the CLIC spec actually requires it for.
+	 */
+	if (clic_trig_edge[d->hwirq])
+		writeb(0, clic_base + d->hwirq * 4 + CLIC_INTIP_OFF);
+}
+
+static int clic_irq_set_type(struct irq_data *d, unsigned int type)
+{
+	u8 attr;
+
+	switch (type) {
+	case IRQ_TYPE_EDGE_RISING:
+		attr = CLIC_INTATTR_MMODE_EDGE;
+		clic_trig_edge[d->hwirq] = 1;
+		break;
+	case IRQ_TYPE_LEVEL_HIGH:
+	case IRQ_TYPE_NONE:
+	default:
+		attr = CLIC_INTATTR_MMODE_LEVEL;
+		clic_trig_edge[d->hwirq] = 0;
+		break;
+	}
+	writeb(attr, clic_base + d->hwirq * 4 + CLIC_INTATTR_OFF);
+	return 0;
+}
+
+static struct irq_chip esp32p4_clic_chip = {
+	.name          = "ESP32P4-CLIC",
+	.irq_mask      = clic_irq_mask,
+	.irq_unmask    = clic_irq_unmask,
+	.irq_ack       = clic_irq_ack,
+	.irq_set_type  = clic_irq_set_type,
+};
+
+static int clic_domain_map(struct irq_domain *d, unsigned int irq,
+			    irq_hw_number_t hwirq)
+{
+	u8 attr;
+	irq_flow_handler_t handler;
+
+	if (clic_intmtx_base && clic_intmtx_source[hwirq])
+		writel(hwirq, clic_intmtx_base + clic_intmtx_source[hwirq] * 4);
+
+	if (clic_trig_edge[hwirq]) {
+		attr = CLIC_INTATTR_MMODE_EDGE;
+		handler = handle_edge_irq;
+	} else {
+		attr = CLIC_INTATTR_MMODE_LEVEL;
+		handler = handle_level_irq;
+	}
+
+	writeb(attr,             clic_base + hwirq * 4 + CLIC_INTATTR_OFF);
+	writeb(CLIC_INTCTL_MAX,  clic_base + hwirq * 4 + CLIC_INTCTL_OFF);
+
+	irq_domain_set_info(d, irq, hwirq, &esp32p4_clic_chip, NULL,
+			    handler, NULL, NULL);
+	return 0;
+}
+
+static int clic_domain_xlate(struct irq_domain *d, struct device_node *controller,
+			      const u32 *intspec, unsigned int intsize,
+			      unsigned long *out_hwirq, unsigned int *out_type)
+{
+	if (intsize < 1 || intspec[0] >= CLIC_NUM_IRQS)
+		return -EINVAL;
+	*out_hwirq = intspec[0];
+	*out_type  = (intsize >= 3) ? intspec[2] : IRQ_TYPE_LEVEL_HIGH;
+
+	if (intsize >= 2)
+		clic_intmtx_source[intspec[0]] = (u8)intspec[1];
+	if (intsize >= 3)
+		clic_trig_edge[intspec[0]] =
+			(intspec[2] == IRQ_TYPE_EDGE_RISING) ? 1 : 0;
+	else
+		clic_trig_edge[intspec[0]] = 0;
+
+	return 0;
+}
+
+static const struct irq_domain_ops clic_domain_ops = {
+	.map    = clic_domain_map,
+	.xlate  = clic_domain_xlate,
+};
+
+static int __init esp32p4_clic_init(struct device_node *np,
+				     struct device_node *parent)
+{
+	clic_base = of_iomap(np, 0);
+	if (!clic_base) {
+		pr_err("cannot map CLIC registers\n");
+		return -ENOMEM;
+	}
+
+	clic_intmtx_base = of_iomap(np, 1);
+
+	esp32p4_clic_domain = irq_domain_add_linear(np, CLIC_NUM_IRQS,
+						     &clic_domain_ops, NULL);
+	if (!esp32p4_clic_domain) {
+		iounmap(clic_base);
+		if (clic_intmtx_base)
+			iounmap(clic_intmtx_base);
+		pr_err("cannot allocate IRQ domain\n");
+		return -ENOMEM;
+	}
+
+	pr_info("%d IRQ slots%s\n", CLIC_NUM_IRQS,
+		clic_intmtx_base ? ", INTMTX routing enabled" : "");
+	return 0;
+}
+
+IRQCHIP_DECLARE(esp32p4_clic, "espressif,esp32p4-clic", esp32p4_clic_init);
--- a/drivers/irqchip/irq-riscv-intc.c
+++ b/drivers/irqchip/irq-riscv-intc.c
@@ -26,9 +26,36 @@
 static unsigned int riscv_intc_custom_base __ro_after_init = BITS_PER_LONG;
 static unsigned int riscv_intc_custom_nr_irqs __ro_after_init;
 
+#ifdef CONFIG_SOC_ESP32P4
+extern struct irq_domain *esp32p4_clic_domain;
+#endif
+
 static void riscv_intc_irq(struct pt_regs *regs)
 {
 	unsigned long cause = regs->cause & ~CAUSE_IRQ_FLAG;
+
+#ifdef CONFIG_SOC_ESP32P4
+	/*
+	 * In CLIC mode, mcause packs interrupt level into bits[29:27]
+	 * (NLBITS=3) alongside the interrupt ID in bits[7:0].  Strip the
+	 * level bits to get the plain slot ID before dispatching.
+	 * External slots (ID >= 16) go via the CLIC domain; 0-15 fall
+	 * through to the standard INTC domain below.
+	 */
+	{
+		unsigned long clic_id = cause & 0xFF;
+
+		if (clic_id >= 16) {
+			if (esp32p4_clic_domain &&
+			    !generic_handle_domain_irq(esp32p4_clic_domain, clic_id))
+				return;
+			pr_warn_ratelimited("Unhandled CLIC irq (id=%ld cause=0x%lx)\n",
+					    clic_id, cause);
+			return;
+		}
+		cause = clic_id;
+	}
+#endif
 
 	if (generic_handle_domain_irq(intc_domain, cause))
 		pr_warn_ratelimited("Failed to handle interrupt (cause: %ld)\n", cause);
