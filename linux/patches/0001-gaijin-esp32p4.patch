 static inline void local_flush_icache_all(void)
 {
+#ifdef CONFIG_SOC_ESP32P4
+	/*
+	 * ESP32-P4 HP core: fence.i does not flush the external-memory
+	 * cache hierarchy (L1 I$/D$/L2). Use the ROM helpers at fixed
+	 * addresses to writeback D$/L2 and invalidate I$. Required for
+	 * self-modifying code / loaded binaries in PSRAM (binfmt_flat,
+	 * kernel modules, eBPF, ...).
+	 *
+	 *   Cache_WriteBack_All(map)   @ 0x4fc00414
+	 *   Cache_Invalidate_All(map)  @ 0x4fc00404
+	 *   L1 DCACHE=BIT(4)=0x10, L1 ICACHE_MASK=0x3, L2=BIT(5)=0x20
+	 *
+	 * The ROM cache-sync engine drives one shared set of CACHE_SYNC
+	 * registers and is not reentrant -- ESP-IDF wraps every call in a
+	 * spinlock critical section. The same thunks are invoked from IRQ
+	 * context by the noncoherent-DMA sync ops (esp32p4_cache.c), so
+	 * run the sequence with local IRQs disabled or a nested DMA sync
+	 * can clobber an in-flight operation.
+	 *
+	 * Deliberately NO whole-L2 invalidate here: L2 is unified, so
+	 * after the writeback it already serves coherent I-fetches, and
+	 * an inv-all(L2) would destroy any line dirtied between the two
+	 * ops (e.g. our own stack traffic evicted from L1D) -- silent
+	 * kernel-memory corruption, paid on every exec.
+	 */
+	void (*wb_all)(uint32_t)  = (void (*)(uint32_t))0x4fc00414UL;
+	void (*inv_all)(uint32_t) = (void (*)(uint32_t))0x4fc00404UL;
+	unsigned long flags;
+
+	local_irq_save(flags);
+	wb_all(0x10);   /* L1 DCACHE writeback */
+	wb_all(0x20);   /* L2 writeback */
+	inv_all(0x03);  /* L1 ICACHE (both halves) invalidate */
+	local_irq_restore(flags);
+#endif
 	asm volatile ("fence.i" ::: "memory");
 }
 
 static inline void local_flush_icache_range(unsigned long start,
 					    unsigned long end)
 {
+#ifdef CONFIG_SOC_ESP32P4
+	void (*wb_addr)(uint32_t, uint32_t, uint32_t)  =
+		(void (*)(uint32_t, uint32_t, uint32_t))0x4fc003f4UL;
+	void (*inv_addr)(uint32_t, uint32_t, uint32_t) =
+		(void (*)(uint32_t, uint32_t, uint32_t))0x4fc003e4UL;
+	unsigned long flags;
+
+	/* Bound each ROM critical section so the display frame-complete IRQ
+	 * can re-arm scanout during large bFLT loads. Keep all four cache
+	 * operations exclusive within a chunk; the shared ROM engine cannot
+	 * be entered recursively by DMA maintenance from an IRQ.
+	 */
+	while (start < end) {
+		uint32_t size = min(end - start, 4096UL);
+
+		local_irq_save(flags);
+		wb_addr(0x10, (uint32_t)start, size);   /* L1 D writeback */
+		wb_addr(0x20, (uint32_t)start, size);   /* L2 writeback */
+		inv_addr(0x03, (uint32_t)start, size);  /* L1 I invalidate */
+		inv_addr(0x20, (uint32_t)start, size);  /* L2 invalidate */
+		local_irq_restore(flags);
+		start += size;
+	}
+
+	asm volatile ("fence.i" ::: "memory");
+#else
 	local_flush_icache_all();
+#endif
 }
 
 #define PG_dcache_clean PG_arch_1
