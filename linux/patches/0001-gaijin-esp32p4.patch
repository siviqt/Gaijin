+++ b/drivers/cache/esp32p4_cache.c
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ESP32-P4 noncoherent DMA cache ops
+ *
+ * The HP RV32 core's external-memory cache (L1 D$ + L2) is not coherent
+ * with bus-master DMA into PSRAM (IDMAC, GDMA, ...). The SoC ROM exposes
+ * fixed-address thunks that drive the cache controller; reuse them as
+ * the riscv_nonstd_cache_ops backend so dma-direct's
+ * arch_sync_dma_for_{device,cpu} hooks do real cache management instead
+ * of being silent no-ops.
+ *
+ * Cache map bits (passed as the first argument to the ROM helpers):
+ *   L1 ICACHE = 0x03 (both ways)
+ *   L1 DCACHE = 0x10 (BIT(4))
+ *   L2        = 0x20 (BIT(5))
+ *
+ * Block size is 64 B (matches L1_CACHE_BYTES on this build).
+ */
+
+#include <linux/init.h>
+#include <linux/irqflags.h>
+#include <linux/printk.h>
+#include <linux/types.h>
+#include <asm/cacheflush.h>
+#include <asm/dma-noncoherent.h>
+
+#define ESP32P4_CACHE_MAP_L1D	0x10
+#define ESP32P4_CACHE_MAP_L2	0x20
+
+typedef void (*esp32p4_cache_op_t)(uint32_t map, uint32_t addr, uint32_t size);
+
+#define esp32p4_cache_writeback  ((esp32p4_cache_op_t)0x4fc003f4UL)
+#define esp32p4_cache_invalidate ((esp32p4_cache_op_t)0x4fc003e4UL)
+
+/*
+ * The ROM cache-sync engine is not reentrant (one shared set of
+ * CACHE_SYNC registers; ESP-IDF wraps every call in a spinlock). These
+ * ops run from IRQ/tasklet context (dw_mmc IDMAC, GDMA) while the
+ * icache-flush inlines in asm/cacheflush.h call the same thunks from
+ * process context, so each sequence must be IRQ-exclusive.
+ *
+ * Invalidates run outer-to-inner (L2 before L1D) so a refill between
+ * the two ops cannot repopulate L1 from a still-stale L2 line.
+ */
+static void esp32p4_dma_cache_wback(phys_addr_t paddr, size_t size)
+{
+	unsigned long flags;
+
+	local_irq_save(flags);
+	esp32p4_cache_writeback(ESP32P4_CACHE_MAP_L1D, (uint32_t)paddr, (uint32_t)size);
+	esp32p4_cache_writeback(ESP32P4_CACHE_MAP_L2,  (uint32_t)paddr, (uint32_t)size);
+	local_irq_restore(flags);
+}
+
+static void esp32p4_dma_cache_inv(phys_addr_t paddr, size_t size)
+{
+	unsigned long flags;
+
+	local_irq_save(flags);
+	esp32p4_cache_invalidate(ESP32P4_CACHE_MAP_L2,  (uint32_t)paddr, (uint32_t)size);
+	esp32p4_cache_invalidate(ESP32P4_CACHE_MAP_L1D, (uint32_t)paddr, (uint32_t)size);
+	local_irq_restore(flags);
+}
+
+static void esp32p4_dma_cache_wback_inv(phys_addr_t paddr, size_t size)
+{
+	unsigned long flags;
+
+	local_irq_save(flags);
+	esp32p4_cache_writeback(ESP32P4_CACHE_MAP_L1D, (uint32_t)paddr, (uint32_t)size);
+	esp32p4_cache_writeback(ESP32P4_CACHE_MAP_L2,  (uint32_t)paddr, (uint32_t)size);
+	esp32p4_cache_invalidate(ESP32P4_CACHE_MAP_L2,  (uint32_t)paddr, (uint32_t)size);
+	esp32p4_cache_invalidate(ESP32P4_CACHE_MAP_L1D, (uint32_t)paddr, (uint32_t)size);
+	local_irq_restore(flags);
+}
+
+static const struct riscv_nonstd_cache_ops esp32p4_cache_ops __initconst = {
+	.wback     = &esp32p4_dma_cache_wback,
+	.inv       = &esp32p4_dma_cache_inv,
+	.wback_inv = &esp32p4_dma_cache_wback_inv,
+};
+
+static int __init esp32p4_cache_init(void)
+{
+	riscv_cbom_block_size = L1_CACHE_BYTES;
+	riscv_noncoherent_supported();
+	riscv_noncoherent_register_cache_ops(&esp32p4_cache_ops);
+	pr_info("esp32p4_cache: registered ROM-thunk noncoherent ops, block=%d\n",
+		L1_CACHE_BYTES);
+	return 0;
+}
+arch_initcall(esp32p4_cache_init);
