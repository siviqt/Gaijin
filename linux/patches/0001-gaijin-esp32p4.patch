 #define flush_icache_range flush_icache_range
 static inline void flush_icache_range(unsigned long start, unsigned long end)
 {
+#ifdef CONFIG_SOC_ESP32P4
+	local_flush_icache_range(start, end);
+#else
 	flush_icache_all();
+#endif
 }
 
