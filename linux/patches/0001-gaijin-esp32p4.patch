@@ -0,0 +1,292 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Gaijin M1: fixed-function USB Serial/JTAG, not the USB OTG controller.
+ * Register semantics: ESP-IDF v6.0.2 esp_hal_usb/esp32p4 USB Serial/JTAG LL.
+ * Preserve the loader's PHY/clock/enumeration state. No IDF runtime calls.
+ */
+#include <linux/console.h>
+#include <linux/io.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/serial_core.h>
+#include <linux/timer.h>
+#include <linux/tty_flip.h>
+
+#define EP1             0x00
+#define EP1_CONF        0x04
+#define WR_DONE         BIT(0)
+#define DATA_FREE       BIT(1)
+#define DATA_AVAIL      BIT(2)
+#define INT_ENA         0x10
+#define INT_CLR         0x14
+#define POLL_INTERVAL   max_t(unsigned long, 1, msecs_to_jiffies(4))
+
+struct p4_jtag {
+	struct uart_port port;
+	struct timer_list poll;
+	bool rx_enabled;
+	bool tx_enabled;
+	bool flush_pending;
+	u64 console_deadline;
+};
+
+static struct p4_jtag *console_port;
+static struct uart_driver p4_driver;
+
+static struct p4_jtag *to_jtag(struct uart_port *port)
+{
+	return container_of(port, struct p4_jtag, port);
+}
+
+static bool p4_ready(struct uart_port *port)
+{
+	return readl(port->membase + EP1_CONF) & DATA_FREE;
+}
+
+static void p4_put(struct uart_port *port, unsigned char ch)
+{
+	writel(ch, port->membase + EP1);
+	to_jtag(port)->flush_pending = true;
+}
+
+/* A full 64-byte packet auto-flushes. Retry WR_DONE when writable to
+ * terminate it with a short packet/ZLP, including an exactly 64-byte write.
+ */
+static void p4_flush(struct uart_port *port)
+{
+	struct p4_jtag *jtag = to_jtag(port);
+
+	if (jtag->flush_pending && p4_ready(port)) {
+		writel(WR_DONE, port->membase + EP1_CONF);
+		jtag->flush_pending = false;
+	}
+}
+
+static void p4_tx(struct uart_port *port)
+{
+	struct p4_jtag *jtag = to_jtag(port);
+	unsigned char ch;
+
+	p4_flush(port);
+	if (!jtag->tx_enabled)
+		return;
+	uart_port_tx_limited(port, ch, 64, p4_ready(port),
+			     p4_put(port, ch), p4_flush(port));
+}
+
+static void p4_poll(struct timer_list *timer)
+{
+	struct p4_jtag *jtag = timer_container_of(jtag, timer, poll);
+	struct uart_port *port = &jtag->port;
+	unsigned long flags;
+	unsigned int count = 0;
+
+	uart_port_lock_irqsave(port, &flags);
+	while (jtag->rx_enabled && count++ < 128 &&
+	       (readl(port->membase + EP1_CONF) & DATA_AVAIL)) {
+		unsigned char ch = readl(port->membase + EP1);
+
+		port->icount.rx++;
+		if (!(port->ignore_status_mask & 1))
+			uart_insert_char(port, 0, 0, ch, TTY_NORMAL);
+	}
+	p4_tx(port);
+	uart_port_unlock_irqrestore(port, flags);
+	if (count)
+		tty_flip_buffer_push(&port->state->port);
+	mod_timer(&jtag->poll, jiffies + POLL_INTERVAL);
+}
+
+static unsigned int p4_tx_empty(struct uart_port *port)
+{
+	return p4_ready(port) && !to_jtag(port)->flush_pending ? TIOCSER_TEMT : 0;
+}
+
+static void p4_set_mctrl(struct uart_port *port, unsigned int mctrl) { }
+static unsigned int p4_get_mctrl(struct uart_port *port)
+{
+	return TIOCM_CAR | TIOCM_CTS | TIOCM_DSR;
+}
+static void p4_stop_tx(struct uart_port *port)
+{
+	to_jtag(port)->tx_enabled = false;
+}
+static void p4_start_tx(struct uart_port *port)
+{
+	to_jtag(port)->tx_enabled = true;
+	p4_tx(port);
+}
+static void p4_stop_rx(struct uart_port *port)
+{
+	to_jtag(port)->rx_enabled = false;
+}
+static int p4_startup(struct uart_port *port)
+{
+	struct p4_jtag *jtag = to_jtag(port);
+
+	/* Poll both FIFOs: no unvalidated USB IRQ routing in this milestone. */
+	writel(0, port->membase + INT_ENA);
+	writel(0x7ffff, port->membase + INT_CLR);
+	jtag->rx_enabled = true;
+	jtag->tx_enabled = true;
+	mod_timer(&jtag->poll, jiffies + POLL_INTERVAL);
+	return 0;
+}
+static void p4_shutdown(struct uart_port *port)
+{
+	/* Serial core calls shutdown without the port spinlock held. */
+	timer_delete_sync(&to_jtag(port)->poll);
+}
+static void p4_set_termios(struct uart_port *port, struct ktermios *termios,
+			   const struct ktermios *old)
+{
+	/* USB has no baud generator, parity or modem flow control. */
+	termios->c_cflag &= ~(CSIZE | PARENB | CSTOPB | CRTSCTS);
+	termios->c_cflag |= CS8 | CLOCAL;
+	port->ignore_status_mask = (termios->c_cflag & CREAD) ? 0 : 1;
+	uart_update_timeout(port, termios->c_cflag, 115200);
+}
+static const char *p4_type(struct uart_port *port) { return "P4 USB Serial/JTAG"; }
+static void p4_config_port(struct uart_port *port, int flags)
+{
+	if (flags & UART_CONFIG_TYPE)
+		port->type = PORT_GENERIC;
+}
+static const struct uart_ops p4_ops = {
+	.tx_empty = p4_tx_empty,
+	.set_mctrl = p4_set_mctrl,
+	.get_mctrl = p4_get_mctrl,
+	.stop_tx = p4_stop_tx,
+	.start_tx = p4_start_tx,
+	.stop_rx = p4_stop_rx,
+	.startup = p4_startup,
+	.shutdown = p4_shutdown,
+	.set_termios = p4_set_termios,
+	.type = p4_type,
+	.config_port = p4_config_port,
+};
+
+static void p4_console_putchar(struct uart_port *port, unsigned char ch)
+{
+	while (!p4_ready(port)) {
+		if (ktime_get_mono_fast_ns() >= to_jtag(port)->console_deadline)
+			return;
+		cpu_relax();
+	}
+	p4_put(port, ch);
+	p4_flush(port);
+}
+static void p4_console_write(struct console *con, const char *s, unsigned int n)
+{
+	struct uart_port *port = &console_port->port;
+	unsigned long flags;
+	bool locked;
+
+	if (oops_in_progress)
+		locked = uart_port_trylock_irqsave(port, &flags);
+	else {
+		uart_port_lock_irqsave(port, &flags);
+		locked = true;
+	}
+	/* Bound an entire printk, even with interrupts off / host disconnected.
+	 * TTY writes instead remain queued and resume when the host returns.
+	 */
+	to_jtag(port)->console_deadline = ktime_get_mono_fast_ns() + 10000000;
+	uart_console_write(port, s, n, p4_console_putchar);
+	if (locked)
+		uart_port_unlock_irqrestore(port, flags);
+}
+static int p4_console_setup(struct console *con, char *options)
+{
+	if (!console_port || con->index > 0)
+		return -ENODEV;
+	con->index = 0;
+	return uart_set_options(&console_port->port, con, 115200, 'n', 8, 'n');
+}
+static struct console p4_console = {
+	.name = "ttyUJ",
+	.write = p4_console_write,
+	.device = uart_console_device,
+	.setup = p4_console_setup,
+	.flags = CON_PRINTBUFFER,
+	.index = -1,
+	.data = &p4_driver,
+};
+static struct uart_driver p4_driver = {
+	.owner = THIS_MODULE,
+	.driver_name = "esp32p4-usb-serial-jtag",
+	.dev_name = "ttyUJ",
+	.nr = 1,
+	.cons = &p4_console,
+};
+static int p4_probe(struct platform_device *pdev)
+{
+	struct p4_jtag *jtag;
+	struct resource *res;
+	int ret;
+
+	if (console_port)
+		return -EBUSY;
+	jtag = devm_kzalloc(&pdev->dev, sizeof(*jtag), GFP_KERNEL);
+	if (!jtag)
+		return -ENOMEM;
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	jtag->port.membase = devm_ioremap_resource(&pdev->dev, res);
+	if (IS_ERR(jtag->port.membase))
+		return PTR_ERR(jtag->port.membase);
+	jtag->port.mapbase = res->start;
+	jtag->port.dev = &pdev->dev;
+	jtag->port.iotype = UPIO_MEM;
+	jtag->port.flags = UPF_BOOT_AUTOCONF;
+	jtag->port.ops = &p4_ops;
+	jtag->port.fifosize = 64;
+	jtag->port.uartclk = 48000000;
+	spin_lock_init(&jtag->port.lock);
+	timer_setup(&jtag->poll, p4_poll, 0);
+	writel(0, jtag->port.membase + INT_ENA);
+	console_port = jtag;
+	ret = uart_add_one_port(&p4_driver, &jtag->port);
+	if (ret) {
+		console_port = NULL;
+		return ret;
+	}
+	platform_set_drvdata(pdev, jtag);
+	dev_info(&pdev->dev, "polled USB console: ttyUJ0 (4 ms)\n");
+	return 0;
+}
+static void p4_remove(struct platform_device *pdev)
+{
+	struct p4_jtag *jtag = platform_get_drvdata(pdev);
+
+	uart_remove_one_port(&p4_driver, &jtag->port);
+	timer_shutdown_sync(&jtag->poll);
+	console_port = NULL;
+}
+static const struct of_device_id p4_of_match[] = {
+	{ .compatible = "espressif,esp32p4-usb-serial-jtag" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, p4_of_match);
+static struct platform_driver p4_platform_driver = {
+	.probe = p4_probe,
+	.remove = p4_remove,
+	.driver = {
+		.name = "esp32p4-usb-serial-jtag",
+		.of_match_table = p4_of_match,
+	},
+};
+static int __init p4_init(void)
+{
+	int ret = uart_register_driver(&p4_driver);
+
+	if (ret)
+		return ret;
+	ret = platform_driver_register(&p4_platform_driver);
+	if (ret)
+		uart_unregister_driver(&p4_driver);
+	return ret;
+}
+module_init(p4_init);
+MODULE_DESCRIPTION("Gaijin ESP32-P4 polled USB Serial/JTAG TTY and console");
+MODULE_LICENSE("GPL");
