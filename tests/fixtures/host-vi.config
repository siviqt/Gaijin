# Native vi regression with the target vi feature set and fatal UB checks.
CONFIG_NOMMU=y
CONFIG_VI=y
CONFIG_FEATURE_VI_MAX_LEN=4096
CONFIG_FEATURE_VI_COLON=y
CONFIG_FEATURE_VI_SEARCH=y
CONFIG_FEATURE_VI_USE_SIGNALS=y
CONFIG_FEATURE_VI_SETOPTS=y
CONFIG_FEATURE_VI_UNDO=y
CONFIG_EXTRA_CFLAGS="-fsanitize=undefined -fno-sanitize-recover=all"
CONFIG_EXTRA_LDFLAGS="-fsanitize=undefined"
