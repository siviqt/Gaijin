BR2_riscv=y
BR2_riscv_custom=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVC=y
# BR2_RISCV_ISA_RVF is not set
# BR2_RISCV_ISA_RVD is not set
BR2_RISCV_32=y
# BR2_RISCV_USE_MMU is not set
BR2_RISCV_ABI_ILP32=y
BR2_BINFMT_FLAT=y
BR2_STATIC_LIBS=y
BR2_TOOLCHAIN_BUILDROOT_UCLIBC=y
BR2_PTHREADS_NONE=y
BR2_TARGET_GENERIC_HOSTNAME="gaijin"
BR2_TARGET_GENERIC_ISSUE="Gaijin USB rescue shell"
BR2_INIT_BUSYBOX=y
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_GAIJIN_PATH)/overlay"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_GAIJIN_PATH)/busybox.fragment"
BR2_PACKAGE_GAIJIN_ABI_CHECK=y
BR2_PACKAGE_GAIJIN_INPUT_TEST=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS_BS_32K=y
BR2_TARGET_ROOTFS_SQUASHFS4_GZIP=y
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_GAIJIN_PATH)/post-build.sh"

BR2_PACKAGE_GAIJIN_STATE=y

BR2_REPRODUCIBLE=y
