#!/bin/sh
# Read-only target acceptance: repeated hashes through the live backing mount.
fail() { echo "M2 SD FAIL: $*"; exit 1; }
[ "$#" -eq 0 ] || fail 'usage: m2-sd-test'
base=/sd/apps/com.github.siviqt.gaijin/boot
awk '$2 == "/" && $3 == "squashfs" && $4 ~ /(^|,)ro(,|$)/ { ok=1 } END { exit !ok }' /proc/mounts || fail 'root is not read-only SquashFS'
awk '$2 == "/sd" && $3 == "vfat" && $4 ~ /(^|,)ro(,|$)/ { ok=1 } END { exit !ok }' /proc/mounts || fail 'FAT backing mount was not preserved read-only'
expected=$(cat "$base/rootfs.sqfs.sha256") || fail 'missing checksum'
i=0
while [ "$i" -lt 3 ]; do
    echo 3 > /proc/sys/vm/drop_caches || fail 'cannot drop read caches'
    actual=$(sha256sum "$base/rootfs.sqfs") || fail 'SD read failed'
    actual=${actual%% *}
    [ "$actual" = "$expected" ] || fail 'SD hash mismatch'
    /usr/bin/gaijin-abi-check || fail 'SD-root executable failed'
    i=$((i + 1))
done
losetup -a
cat /proc/mounts
free
echo 'M2 SD PASS: live read-only root, preserved FAT/loop backing and three hash/exec runs'
